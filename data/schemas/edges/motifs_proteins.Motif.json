{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/motifs_proteins.Motif.json",
  "accessible_via": {
    "return": "_id, name, inverse_name, biological_process, source, class, method, files_filesets"
  },
  "db_collection_name": "motifs_proteins",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Motif key and Ensembl protein ID joined by an underscore.",
          "example": "TFDP1_HUMAN_HOCOMOCOv11_ENSP00000364519"
        },
        "_from": {
          "type": "string",
          "description": "Handle of the HOCOMOCO motif.",
          "example": "motifs/TFDP1_HUMAN_HOCOMOCOv11",
          "pattern": "^motifs/",
          "collections": [
            "motifs"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Handle of the Ensembl protein for the transcription factor the motif models.",
          "example": "proteins/ENSP00000364519",
          "pattern": "^proteins/ENSP[0-9]{11}$",
          "collections": [
            "proteins"
          ]
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "is used by"
          ]
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "uses"
          ]
        },
        "biological_process": {
          "type": "string",
          "description": "Gene Ontology term GO:0003677 (DNA binding).",
          "enum": [
            "ontology_terms/GO_0003677"
          ]
        },
        "source": {
          "$ref": "../mixins.json#/source",
          "enum": [
            "HOCOMOCOv11"
          ]
        },
        "class": {
          "$ref": "../mixins.json#/class",
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "$ref": "../mixins.json#/method",
          "enum": [
            "HOCOMOCO"
          ]
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "name",
        "inverse_name",
        "biological_process",
        "source",
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
