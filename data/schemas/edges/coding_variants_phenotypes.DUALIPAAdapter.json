{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/coding_variants_phenotypes.DUALIPAAdapter.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "description": "Coding variant key, phenotype ontology term and source file accession, joined by underscores."
        },
        "_from": {
          "example": "coding_variants/ACSF3_ENST00000317447_p.Ala17Pro_c.49G-C",
          "pattern": "^coding_variants/",
          "collections": [
            "coding_variants"
          ]
        },
        "_to": {
          "example": "ontology_terms/BAO:0040014",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI6224HZMG",
          "pattern": "^https://data.igvf.org/tabular-files/"
        },
        "name": {
          "enum": [
            "mutational effect"
          ]
        },
        "inverse_name": {
          "enum": [
            "altered due to mutation"
          ]
        },
        "biological_context": {
          "example": "HEK293 cell line, female, Homo sapiens"
        },
        "biosample_term": {
          "example": "ontology_terms/EFO_0001182"
        },
        "method": {
          "enum": [
            "DUAL-IPA"
          ]
        },
        "label": {
          "enum": [
            "protein variant effect"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "avg_gfp": {
          "title": "Average GFP",
          "type": "number",
          "description": "Single cell mean GFP fluorescence value per well"
        },
        "avg_mcherry": {
          "title": "Average mCherry",
          "type": "number",
          "description": "Single cell mean mCherry fluorescence value per well"
        },
        "avg_GFP_mCherry_ratio": {
          "title": "Average GFP to mCherry Ratio",
          "type": "number",
          "description": "Ratio of avg_gfp to avg_mcherry for the well, the abundance readout for the variant allele."
        },
        "wt_GFP_mCherry_ratio": {
          "title": "Wild-Type GFP to mCherry Ratio",
          "type": "number",
          "description": "Ratio of avg_gfp/avg_mcherry of related wild-type measurement"
        },
        "allele_wt_ratio": {
          "title": "Allele to Wild-Type Ratio",
          "type": "number",
          "description": "Ratio of avg_GFP_mCherry_ratio/wt_GFP_mCherry_ratio"
        },
        "dualipa_abun_score": {
          "title": "DUAL-IPA Abundance Score",
          "type": "number",
          "description": "Abundance score for the variant: the log2 Z-score of allele_wt_ratio against the wild-type distribution, computed as (log2(allele_wt_ratio) - log2(wt_mean)) / log2(wt_std)."
        },
        "dualipa_abun_change": {
          "title": "DUAL-IPA Abundance Change",
          "type": "string",
          "enum": [
            "Y",
            "N",
            "Uncertain"
          ],
          "description": "Whether the variant shows a significant change in abundance, judged against thresholds derived by the log-likelihood-ratio method."
        }
      },
      "required": [
        "files_filesets",
        "biological_context",
        "biosample_term",
        "avg_gfp",
        "avg_mcherry",
        "avg_GFP_mCherry_ratio",
        "wt_GFP_mCherry_ratio",
        "allele_wt_ratio",
        "dualipa_abun_score",
        "dualipa_abun_change"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "coding_variants_phenotypes"
}
