{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/complexes_terms.EBIComplex.json",
  "db_collection_name": "complexes_terms",
  "allOf": [
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "label": {
          "$ref": "../mixins.json#/classification/label"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        }
      }
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Complex accession and ontology term key joined by an underscore.",
          "example": "CPX-1_GO_0071144"
        },
        "_from": {
          "type": "string",
          "description": "Document handle of the source node, in collection/key form.",
          "example": "complexes/CPX-1",
          "pattern": "^complexes/",
          "collections": [
            "complexes"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Document handle of the target node, in collection/key form.",
          "example": "ontology_terms/GO_0071144",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "term_name": {
          "type": "string",
          "description": "Ontology term name.",
          "example": "heteromeric SMAD protein complex"
        },
        "source": {
          "type": "string",
          "enum": [
            "EBI"
          ]
        },
        "source_url": {
          "type": "string",
          "enum": [
            "https://www.ebi.ac.uk/complexportal/"
          ]
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "associated with",
            "is located in",
            "involved in",
            "has the function"
          ]
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "associated with",
            "contains",
            "has component",
            "is a function of"
          ]
        },
        "class": {
          "type": "string"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI1444TRQL",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "source",
        "source_url",
        "name",
        "inverse_name",
        "class",
        "method",
        "label",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
