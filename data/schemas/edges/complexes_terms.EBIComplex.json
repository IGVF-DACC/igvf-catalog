{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/complexes_terms.EBIComplex.json",
  "db_collection_name": "complexes_terms",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Complex accession and ontology term key joined by an underscore.",
          "example": "CPX-1_GO_0071144"
        },
        "_from": {
          "example": "complexes/CPX-1",
          "pattern": "^complexes/",
          "collections": [
            "complexes"
          ]
        },
        "_to": {
          "example": "ontology_terms/GO_0071144",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "term_name": {
          "type": "string",
          "description": "Ontology term name.",
          "example": "heteromeric SMAD protein complex"
        },
        "source": {
          "enum": [
            "EBI"
          ]
        },
        "source_url": {
          "enum": [
            "https://www.ebi.ac.uk/complexportal/"
          ]
        },
        "name": {
          "enum": [
            "associated with",
            "is located in",
            "involved in",
            "has the function"
          ],
          "example": "associated with"
        },
        "inverse_name": {
          "enum": [
            "associated with",
            "contains",
            "has component",
            "is a function of"
          ],
          "example": "associated with"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "_key",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
