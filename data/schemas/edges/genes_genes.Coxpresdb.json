{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/genes_genes.Coxpresdb.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "description": "The two NCBI Entrez gene IDs in canonical order and coxpresdb, joined by underscores. Ensembl IDs are used instead when either gene maps to more than one Ensembl identifier.",
          "example": "80185_2222_coxpresdb"
        },
        "_from": {
          "description": "Handle of the first gene in the pair (smaller Entrez ID).",
          "example": "genes/ENSG00000129696",
          "pattern": "^genes/ENSG[0-9]{11}(?:_PAR_Y)?$",
          "collections": [
            "genes"
          ]
        },
        "_to": {
          "description": "Handle of the second gene in the pair (larger Entrez ID).",
          "example": "genes/ENSG00000079459",
          "pattern": "^genes/ENSG[0-9]{11}(?:_PAR_Y)?$",
          "collections": [
            "genes"
          ]
        },
        "z_score": {
          "title": "Z-Score",
          "type": "number",
          "description": "COXPRESdb coexpression z-score: 3 is a false-positive rate of 0.1%, 0 for no value.",
          "example": 3.2
        },
        "associated_process": {
          "title": "Associated Process",
          "type": "string",
          "description": "Gene Ontology term for gene expression, as a handle into ontology_terms.",
          "enum": [
            "ontology_terms/GO_0010467"
          ]
        },
        "method": {
          "enum": [
            "COXPRESdb"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "label": {
          "enum": [
            "co-expression"
          ]
        },
        "source": {
          "enum": [
            "COXPRESdb"
          ]
        },
        "source_url": {
          "enum": [
            "https://coxpresdb.jp/"
          ]
        },
        "name": {
          "enum": [
            "coexpressed with"
          ]
        },
        "inverse_name": {
          "enum": [
            "coexpressed with"
          ]
        }
      },
      "required": [
        "z_score",
        "associated_process",
        "files_filesets"
      ],
      "additionalProperties": false,
      "accessible_via": {
        "filter_by_range": "z_score",
        "return": "z_score, associated_process, source, source_url, method, class, label, files_filesets"
      }
    }
  ],
  "db_collection_name": "genes_genes"
}
