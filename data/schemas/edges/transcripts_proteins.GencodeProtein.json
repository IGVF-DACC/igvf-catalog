{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "edges/transcripts_proteins.GencodeProtein.json",
  "db_collection_name": "transcripts_proteins",
  "type": "object",
  "properties": {
    "_from": {
      "type": "string",
      "description": "Document handle of the transcript.",
      "example": "transcripts/ENST00000456328 or transcripts/ENSMUST00000456328",
      "pattern": "^transcripts/ENST[0-9]{11}(?:_PAR_Y)?$|transcripts/ENSMUST[0-9]{11}(?:_PAR_Y)?$",
      "collections": [
        "transcripts",
        "mm_transcripts"
      ]
    },
    "_to": {
      "type": "string",
      "description": "Document handle of the protein the transcript encodes.",
      "example": "proteins/ENSP00000456328",
      "pattern": "^proteins/ENSP[0-9]{11}$",
      "collections": [
        "proteins"
      ]
    },
    "source": {
      "type": "string",
      "description": "The database, dataset or organization that is a source for these data.",
      "enum": [
        "GENCODE"
      ]
    },
    "version": {
      "type": "string",
      "description": "GENCODE release the annotation was taken from.",
      "enum": [
        "v43",
        "vM36"
      ]
    },
    "source_url": {
      "type": "string",
      "description": "The URL for the source.",
      "enum": [
        "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_43/gencode.v43.chr_patch_hapl_scaff.annotation.gtf.gz",
        "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M36/gencode.vM36.chr_patch_hapl_scaff.annotation.gtf.gz"
      ]
    },
    "organism": {
      "type": "string",
      "description": "Species this annotation describes.",
      "enum": [
        "Homo sapiens",
        "Mus musculus"
      ]
    },
    "name": {
      "type": "string",
      "description": "Directional human readable label for the relationship, _from to _to.",
      "enum": [
        "translates to"
      ]
    },
    "inverse_name": {
      "type": "string",
      "description": "Reversed directional human readable label for the relationship, _to to _from.",
      "enum": [
        "translated from"
      ]
    },
    "biological_process": {
      "type": "string",
      "description": "Gene Ontology term for the process this edge represents. GO_0006412 is 'translation'.",
      "enum": [
        "ontology_terms/GO_0006412"
      ]
    }
  },
  "required": [
    "_from",
    "_to",
    "source",
    "version",
    "source_url",
    "organism",
    "name",
    "inverse_name",
    "biological_process"
  ],
  "additionalProperties": false,
  "accessible_via": {
    "return": "source, source_url"
  }
}
