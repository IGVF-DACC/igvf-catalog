{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_diseases_genes.Clingen.json",
  "accessible_via": {
    "return": "inheritance_mode, class, method, label, files_filesets, source, source_url"
  },
  "db_collection_name": "variants_diseases_genes",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "description": "SHA-256 hash of the variants_diseases edge key and the Ensembl gene ID."
        },
        "_from": {
          "pattern": "^variants_diseases/",
          "collections": [
            "variants_diseases"
          ]
        },
        "_to": {
          "example": "genes/ENSG00000171759",
          "pattern": "^genes/",
          "collections": [
            "genes"
          ]
        },
        "name": {
          "enum": [
            "associated with"
          ],
          "example": "associated with"
        },
        "inverse_name": {
          "enum": [
            "associated with"
          ],
          "example": "associated with"
        },
        "inheritance_mode": {
          "title": "Inheritance Mode",
          "type": "string",
          "description": "Mode of inheritance for the disease the assertion applies to.",
          "example": "Autosomal recessive inheritance"
        },
        "source": {
          "enum": [
            "ClinGen"
          ]
        },
        "source_url": {
          "enum": [
            "https://search.clinicalgenome.org/kb/downloads"
          ]
        }
      },
      "required": [
        "inheritance_mode",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
