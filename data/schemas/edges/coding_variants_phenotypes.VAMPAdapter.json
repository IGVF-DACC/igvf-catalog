{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/coding_variants_phenotypes.VAMPAdapter.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Coding variant key, phenotype ontology term and source file accession, joined by underscores."
        },
        "_from": {
          "example": "coding_variants/coding_var_1",
          "pattern": "^coding_variants/",
          "collections": [
            "coding_variants"
          ]
        },
        "_to": {
          "example": "ontology_terms/phenotype_1",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI0332UGDD",
          "pattern": "^https://data.igvf.org/tabular-files/"
        },
        "name": {
          "enum": [
            "mutational effect"
          ]
        },
        "inverse_name": {
          "enum": [
            "altered due to mutation"
          ]
        },
        "files_filesets": {
          "type": "string",
          "description": "Handle of the files_filesets record for the IGVF file this measurement was read from.",
          "example": "files_filesets/IGVFFI0332UGDD",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        },
        "biological_context": {
          "type": "string",
          "description": "Plain-language summary of the sample the assay was run in, taken from the file's fileset metadata. Null when the fileset carries no summary.",
          "items": {
            "type": "string"
          },
          "example": "HAP-1"
        },
        "biosample_term": {
          "type": "string",
          "description": "Ontology term for the sample the assay was run in, taken from the file's fileset metadata. Null when the fileset lists no sample.",
          "items": {
            "type": "string"
          },
          "example": "ontology_terms/EFO_0002067"
        },
        "method": {
          "enum": [
            "VAMP-seq"
          ]
        },
        "label": {
          "enum": [
            "protein variant effect"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "description": "Overall VAMP-seq abundance score for the variant, the mean of its replicate measurements. Normalized so that the median synonymous variant scores 1 and the median nonsense variant scores 0, so lower scores mean reduced abundance of the variant protein."
        },
        "standard_error": {
          "type": [
            "number",
            "null"
          ],
          "description": "Standard error of the overall score."
        },
        "rep1_score": {
          "type": [
            "number",
            "null"
          ],
          "description": "Abundance score calculated for replicate 1."
        },
        "rep2_score": {
          "type": [
            "number",
            "null"
          ],
          "description": "Abundance score calculated for replicate 2."
        },
        "rep3_score": {
          "type": [
            "number",
            "null"
          ],
          "description": "Abundance score calculated for replicate 3."
        }
      },
      "required": [
        "_key",
        "files_filesets",
        "biosample_term",
        "biological_context"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "coding_variants_phenotypes"
}
