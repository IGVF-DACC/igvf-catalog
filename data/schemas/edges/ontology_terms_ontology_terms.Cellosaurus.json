{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/ontology_terms_ontology_terms.Cellosaurus.json",
  "db_collection_name": "ontology_terms_ontology_terms",
  "allOf": [
    {
      "$ref": "../mixins.json#/provenance"
    },
    {
      "properties": {
        "method": {
          "$ref": "../mixins.json#/classification/properties/method"
        },
        "class": {
          "$ref": "../mixins.json#/classification/properties/class"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/properties/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Source term key, the relationship predicate and the target term key, joined by underscores."
        },
        "_from": {
          "type": "string",
          "description": "Handle of the source cell-line term.",
          "example": "ontology_terms/CVCL_JJ44",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Handle of the cross-referenced term, parent cell line, or sister cell line.",
          "example": "ontology_terms/CVCL_B854",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "database cross-reference",
            "derived from",
            "originate from same individual as"
          ]
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "database cross-reference",
            "derives",
            "originate from same individual as"
          ]
        },
        "source": {
          "enum": [
            "Cellosaurus"
          ]
        },
        "source_url": {
          "enum": [
            "https://www.cellosaurus.org/"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "name",
        "inverse_name",
        "source",
        "source_url",
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
