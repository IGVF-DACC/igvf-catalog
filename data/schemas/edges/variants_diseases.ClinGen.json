{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_diseases.ClinGen.json",
  "accessible_via": {
    "return": "assertion, gene_id, pmids, class, method, label, files_filesets"
  },
  "db_collection_name": "variants_diseases",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/properties/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "SHA-256 hash of the variant key and the disease ontology term key."
        },
        "_from": {
          "example": "variants/NC_000005.10:1779518:G:A",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "ontology_terms/MONDO_0009861",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "gene_id": {
          "type": "string",
          "description": "Ensembl gene ID",
          "example": "genes/ENSG00000171759",
          "pattern": "^genes/"
        },
        "assertion": {
          "type": "string",
          "description": "ACMG/AMP pathogenicity classification assigned by a ClinGen Variant Curation Expert Panel.",
          "enum": [
            "Benign",
            "Likely Benign",
            "Likely Pathogenic",
            "Pathogenic",
            "Uncertain Significance"
          ]
        },
        "pmids": {
          "type": "array",
          "description": "Pubmed identifiers.",
          "example": [
            "http://pubmed.ncbi.nlm.nih.gov/2574002",
            "http://pubmed.ncbi.nlm.nih.gov/2574002",
            "http://pubmed.ncbi.nlm.nih.gov/9450897"
          ]
        },
        "name": {
          "enum": [
            "associated with"
          ],
          "example": "associated with"
        },
        "inverse_name": {
          "enum": [
            "associated with"
          ],
          "example": "associated with"
        },
        "source": {
          "enum": [
            "ClinGen"
          ]
        },
        "source_url": {
          "enum": [
            "https://search.clinicalgenome.org/kb/downloads"
          ]
        }
      },
      "required": [
        "_key",
        "gene_id",
        "assertion",
        "pmids",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
