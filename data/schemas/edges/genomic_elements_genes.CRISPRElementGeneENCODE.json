{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/genomic_elements_genes.CRISPRElementGeneENCODE.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "crispr_modality": {
          "$ref": "../mixins.json#/crispr_modality"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Genomic element key, the Ensembl ID of the readout gene and the source file accession joined by underscores.",
          "example": "CRISPR_chr1_3774714_3775214_GRCh38_ENSG00000116198_ENCFF968BZL"
        },
        "_from": {
          "example": "genomic_elements/CRISPR_chr1_3774714_3775214_GRCh38_ENCFF968BZL",
          "pattern": "^genomic_elements/",
          "collections": [
            "genomic_elements"
          ]
        },
        "_to": {
          "example": "genes/ENSG00000116198",
          "pattern": "^genes/",
          "collections": [
            "genes"
          ]
        },
        "effect_size": {
          "type": "number",
          "description": "Signed relative change in target-gene expression after CRISPRi of the element (ENCODE EffectSize). Negative values mean lower expression. Missing values are stored as 0.",
          "example": -0.293431866
        },
        "log2FC": {
          "type": "number",
          "description": "Effect size converted to log2 scale."
        },
        "p_value": {
          "type": [
            "number",
            "null"
          ],
          "description": "Uncorrected differential-expression p-value for the element\u2013gene pair. Null when the source has none."
        },
        "p_value_adj": {
          "type": [
            "number",
            "null"
          ],
          "description": "Benjamini\u2013Hochberg FDR of the differential-expression test. Null when the source has none.",
          "example": 0.004023984
        },
        "neg_log10_pvalue": {
          "type": [
            "number",
            "null"
          ],
          "description": "Negative log 10 p-value of the measurement or prediction"
        },
        "neg_log10_pvalue_adj": {
          "type": [
            "number",
            "null"
          ],
          "description": "Adjusted negative log 10 p-value of the measurement or prediction"
        },
        "significant": {
          "type": "boolean",
          "description": "Boolean indicator of the significance of the element-gene interactions.",
          "example": true
        },
        "method": {
          "enum": [
            "CRISPR screen"
          ]
        },
        "crispr_modality": {
          "enum": [
            "interference"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "label": {
          "enum": [
            "regulatory element effect on gene expression"
          ]
        },
        "source": {
          "enum": [
            "ENCODE"
          ]
        },
        "source_url": {
          "enum": [
            "https://www.encodeproject.org/files/ENCFF968BZL/"
          ]
        },
        "files_filesets": {
          "enum": [
            "files_filesets/ENCFF968BZL"
          ],
          "example": "files_filesets/ENCFF968BZL"
        },
        "biological_context": {
          "enum": [
            "K562"
          ]
        },
        "biosample_term": {
          "enum": [
            "ontology_terms/EFO_0002067"
          ]
        },
        "name": {
          "enum": [
            "regulates"
          ]
        },
        "inverse_name": {
          "enum": [
            "regulated by"
          ]
        }
      },
      "required": [
        "_key",
        "effect_size",
        "log2FC",
        "p_value",
        "p_value_adj",
        "neg_log10_pvalue",
        "neg_log10_pvalue_adj",
        "significant",
        "files_filesets",
        "crispr_modality",
        "biological_context",
        "biosample_term"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "filter_by_range": "effect_size, log2FC",
    "return": "class, label, method, crispr_modality, source, source_url, files_filesets, biological_context, biosample_term, effect_size, log2FC, p_value"
  },
  "db_collection_name": "genomic_elements_genes"
}
