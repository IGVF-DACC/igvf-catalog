{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_phenotypes.cV2F.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Variant key, phenotype ontology term and source file accession joined by underscores. For example NC_000001.11:91420:T:C_GO_0003674_IGVFFI0332UGDD.",
          "example": "NC_000001.11:91420:T:C_GO_0003674_IGVFFI0332UGDD"
        },
        "_from": {
          "example": "variants/NC_000001.11:91420:T:C",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "ontology_terms/GO_0003674",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "score": {
          "type": "number",
          "description": "cV2F prediction value for the variant, a continuous score for how likely the variant is to be functional. Only variants passing the 0.75 threshold are loaded."
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI0332UGDD",
          "pattern": "^https://data.igvf.org/tabular-files/"
        },
        "name": {
          "enum": [
            "associated with"
          ]
        },
        "inverse_name": {
          "enum": [
            "associated with"
          ]
        },
        "files_filesets": {
          "type": "string",
          "description": "Handle of the files_filesets record for the IGVF file this record was read from.",
          "example": "files_filesets/IGVFFI0332UGDD",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        },
        "biosample_term": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ontology term for the sample this applies to, taken from the file's fileset metadata. Null when the fileset lists no sample. Null for the sample-agnostic prediction file.",
          "example": "ontology_terms/UBERON_0002048",
          "pattern": "^ontology_terms/"
        },
        "method": {
          "enum": [
            "cV2F"
          ]
        },
        "class": {
          "enum": [
            "prediction"
          ]
        },
        "label": {
          "enum": [
            "predicted variant effect on phenotype"
          ]
        },
        "biological_context": {
          "type": [
            "string",
            "null"
          ],
          "description": "Plain-language summary of the sample this applies to, taken from the file's fileset metadata. Null when the fileset carries no summary. Null for the sample-agnostic prediction file.",
          "example": "lung"
        }
      },
      "required": [
        "_key",
        "score",
        "files_filesets",
        "biosample_term",
        "biological_context"
      ]
    }
  ],
  "additionalProperties": false,
  "db_collection_name": "variants_phenotypes",
  "accessible_via": {
    "return": "name, score, files_filesets, biosample_term, biological_context, method, class, label, source, source_url",
    "filter_by_range": "score"
  }

}
