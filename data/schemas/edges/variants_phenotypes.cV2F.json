{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_phenotypes.cV2F.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "title": "Document Key",
          "type": "string",
          "description": "Variant key, phenotype ontology term and source file accession joined by underscores.",
          "example": "NC_000001.11:91420:T:C_GO_0003674_IGVFFI0332UGDD"
        },
        "_from": {
          "example": "variants/NC_000001.11:91420:T:C",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "ontology_terms/GO_0003674",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "score": {
          "title": "Score",
          "type": "number",
          "description": "cV2F score: prediction value for the variant, a continuous score between 0 and 1 for how likely the variant is to be functional."
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI0332UGDD",
          "pattern": "^https://data.igvf.org/tabular-files/"
        },
        "name": {
          "enum": [
            "associated with"
          ]
        },
        "inverse_name": {
          "enum": [
            "associated with"
          ]
        },
        "biosample_term": {
          "type": [
            "string",
            "null"
          ],
          "example": "ontology_terms/UBERON_0002048"
        },
        "method": {
          "enum": [
            "cV2F"
          ]
        },
        "class": {
          "enum": [
            "prediction"
          ]
        },
        "label": {
          "enum": [
            "predicted variant effect on phenotype"
          ]
        },
        "biological_context": {
          "type": [
            "string",
            "null"
          ],
          "example": "lung"
        }
      },
      "required": [
        "_key",
        "score",
        "files_filesets",
        "biosample_term",
        "biological_context"
      ]
    }
  ],
  "additionalProperties": false,
  "db_collection_name": "variants_phenotypes",
  "accessible_via": {
    "return": "name, score, files_filesets, biosample_term, biological_context, method, class, label, source, source_url",
    "filter_by_range": "score"
  }
}
