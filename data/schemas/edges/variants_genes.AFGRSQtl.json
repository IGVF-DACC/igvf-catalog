{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_genes.AFGRSQtl.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "SHA-256 hash of the variant key, LeafCutter intron identifier and Ensembl gene ID."
        },
        "_from": {
          "example": "variants/NC_000001.11:10000:T:A",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "genes/ENSG00000187583",
          "pattern": "^genes/ENSG[0-9]{11}(?:_PAR_Y)?$",
          "collections": [
            "genes"
          ]
        },
        "biological_context": {
          "enum": [
            "lymphoblastoid cell line"
          ]
        },
        "biosample_term": {
          "enum": [
            "ontology_terms/EFO_0005292"
          ]
        },
        "chr": {
          "type": "string",
          "description": "Chromosome of the variant, prefixed with chr. Scaffolds and patch regions use UCSC-style names.",
          "example": "chr1",
          "pattern": "^chr"
        },
        "neg_log10_pvalue": {
          "type": "number",
          "description": "Negative log 10 p-value of the measurement or prediction"
        },
        "p_value": {
          "type": "number",
          "description": "Nominal p-value of association between the variant and the splice junction, from the African-population meta-analysis."
        },
        "effect_size": {
          "type": "number",
          "description": "Regression coefficient (beta) of the alternate allele on the quantile-normalized intron excision ratio."
        },
        "posterior_inclusion_probability": {
          "type": [
            "number",
            "null"
          ],
          "description": "Posterior inclusion probability that this variant is causal for the splice QTL."
        },
        "log2FC": {
          "type": [
            "number",
            "null"
          ],
          "description": "log2 fold change of intron excision associated with the alternate allele."
        },
        "significant": {
          "type": "boolean",
          "description": "Boolean indicating the significance of the variant association with splicing."
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "enum": [
            "spliceQTL"
          ]
        },
        "label": {
          "enum": [
            "spliceQTL"
          ]
        },
        "intron_chr": {
          "type": "string",
          "description": "Chromosome of the spliced intron",
          "example": "chr1",
          "pattern": "^chr"
        },
        "intron_start": {
          "type": "number",
          "description": "Start position of the spliced intron."
        },
        "intron_end": {
          "type": "number",
          "description": "End position of the spliced intron."
        },
        "source": {
          "enum": [
            "AFGR"
          ]
        },
        "source_url": {
          "enum": [
            "https://github.com/smontgomlab/AFGR"
          ]
        },
        "name": {
          "enum": [
            "modulates splicing of"
          ]
        },
        "inverse_name": {
          "enum": [
            "splicing modulated by"
          ]
        },
        "biological_process": {
          "type": "string",
          "description": "Gene Ontology term for regulation of RNA splicing.",
          "enum": [
            "ontology_terms/GO_0043484"
          ]
        }
      },
      "required": [
        "_key",
        "chr",
        "neg_log10_pvalue",
        "p_value",
        "effect_size",
        "biological_context",
        "biosample_term",
        "biological_process",
        "intron_chr",
        "intron_start",
        "intron_end",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "filter_by_range": "intron_start, intron_end, neg_log10_pvalue, effect_size",
    "simplified_return": "class, method, label, source, neg_log10_pvalue, biological_context",
    "return": "intron_chr, intron_start, intron_end, effect_size, neg_log10_pvalue, source, class, method, label, p_value, chr, source_url, files_filesets, biological_context, biosample_term"
  },
  "db_collection_name": "variants_genes"
}
