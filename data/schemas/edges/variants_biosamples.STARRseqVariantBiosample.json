{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_biosamples.STARRseqVariantBiosample.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "label": {
          "$ref": "../mixins.json#/classification/label"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/file_metadata/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/file_metadata/biosample_term"
        },
        "treatments_term_ids": {
          "$ref": "../mixins.json#/file_metadata/treatments_term_ids"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Variant key, biosample ontology term and source file accession joined by underscores.",
          "example": "NC_000001.11:14772:C:T_EFO_0002067_IGVFFI0099XJHU"
        },
        "_from": {
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "name": {
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "modulates expression in"
          ]
        },
        "inverse_name": {
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "regulatory activity modulated by"
          ]
        },
        "log2FC": {
          "type": "number",
          "description": "Log2 fold change for variant effect on gene expression."
        },
        "inputCountRef": {
          "type": "number",
          "description": "Input count for the reference allele."
        },
        "inputCountAlt": {
          "type": "number",
          "description": "Input count for the alternative allele."
        },
        "outputCountRef": {
          "type": "number",
          "description": "Output count for the reference allele."
        },
        "outputCountAlt": {
          "type": "number",
          "description": "Output count for the alternative allele."
        },
        "postProbEffect": {
          "type": "number",
          "description": "Posterior probability that the variant has a regulatory effect."
        },
        "significant": {
          "type": "boolean",
          "description": "Boolean indicating the significance of the variant effect, based on the posterior probability."
        },
        "CI_lower_95": {
          "type": "number",
          "description": "Lower bound of a 95% interval for the variant effect."
        },
        "CI_upper_95": {
          "type": "number",
          "description": "Upper bound of a 95% interval for the variant effect."
        },
        "label": {
          "enum": [
            "variant effect on regulatory element activity"
          ]
        },
        "method": {
          "enum": [
            "STARR-seq"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI7664HHXI",
          "pattern": "^https://data.igvf.org/tabular-files/"
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI7664HHXI",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        },
        "biological_context": {
          "example": "glutamatergic neuron differentiated cell specimen, pooled cell specimen from IGVFDO6638HIAD"
        },
        "biosample_term": {
          "example": "ontology_terms/EFO_0002067",
          "pattern": "^ontology_terms/"
        },
        "treatments_term_ids": {
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "_key",
        "log2FC",
        "inputCountRef",
        "inputCountAlt",
        "outputCountRef",
        "outputCountAlt",
        "postProbEffect",
        "significant",
        "CI_lower_95",
        "CI_upper_95",
        "files_filesets",
        "biosample_term",
        "biological_context",
        "treatments_term_ids"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "variants_biosamples"
}
