{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/pathways_pathways.Reactome.json",
  "accessible_via": {
    "return": "source, source_url, organism, class, method, label, files_filesets"
  },
  "db_collection_name": "pathways_pathways",
  "allOf": [
    {
      "properties": {
        "organism": {
          "$ref": "../mixins.json#/organism/organism"
        }
      }
    },
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "label": {
          "$ref": "../mixins.json#/classification/label"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        }
      }
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Parent and child Reactome pathway IDs joined by an underscore.",
          "example": "R-HSA-1971475_R-HSA-1971476"
        },
        "_from": {
          "type": "string",
          "description": "Document handle of the source node, in collection/key form.",
          "example": "pathways/R-HSA-1971475",
          "pattern": "^pathways/R-HSA-[0-9]+$",
          "collections": [
            "pathways"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Document handle of the target node, in collection/key form.",
          "example": "pathways/R-HSA-1971476",
          "pattern": "^pathways/R-HSA-[0-9]+$",
          "collections": [
            "pathways"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "Reactome"
          ]
        },
        "source_url": {
          "type": "string",
          "enum": [
            "https://reactome.org/"
          ]
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "parent of"
          ]
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "child of"
          ]
        },
        "organism": {
          "enum": [
            "Homo sapiens"
          ]
        },
        "class": {
          "type": "string",
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI8363VRKN",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "name",
        "inverse_name",
        "source",
        "source_url",
        "organism",
        "class",
        "method",
        "label",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
