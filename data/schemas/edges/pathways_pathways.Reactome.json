{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/pathways_pathways.Reactome.json",
  "accessible_via": {
    "return": "source, source_url, organism, class, method, label, files_filesets"
  },
  "db_collection_name": "pathways_pathways",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "organism": {
          "$ref": "../mixins.json#/organism"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "title": "Document Key",
          "type": "string",
          "description": "Parent and child Reactome pathway IDs joined by an underscore.",
          "example": "R-HSA-1971475_R-HSA-1971476"
        },
        "_from": {
          "example": "pathways/R-HSA-1971475",
          "pattern": "^pathways/R-HSA-[0-9]+$",
          "collections": [
            "pathways"
          ]
        },
        "_to": {
          "example": "pathways/R-HSA-1971476",
          "pattern": "^pathways/R-HSA-[0-9]+$",
          "collections": [
            "pathways"
          ]
        },
        "source": {
          "enum": [
            "Reactome"
          ]
        },
        "source_url": {
          "enum": [
            "https://reactome.org/"
          ]
        },
        "name": {
          "enum": [
            "parent of"
          ],
          "example": "parent of"
        },
        "inverse_name": {
          "enum": [
            "child of"
          ],
          "example": "child of"
        },
        "organism": {
          "enum": [
            "Homo sapiens"
          ]
        },
        "class": {
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "_key",
        "organism",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
