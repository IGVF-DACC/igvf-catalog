{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/genomic_elements_phenotypes.CRISPRElementPhenotype.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        },
        "treatments_term_ids": {
          "$ref": "../mixins.json#/treatments_term_ids"
        },
        "crispr_modality": {
          "$ref": "../mixins.json#/crispr_modality"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Genomic element key and phenotype ontology term joined by an underscore.",
          "example": "CRISPR_chr1_101174581_101175330_GRCh38_IGVFFI5135QZCS_GO_0016477"
        },
        "_from": {
          "example": "genomic_elements/CRISPR_chr1_101174581_101175330_GRCh38_IGVFFI5135QZCS",
          "pattern": "^genomic_elements/",
          "collections": [
            "genomic_elements"
          ]
        },
        "_to": {
          "example": "ontology_terms/GO_0016477",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "z_score": {
          "type": "number",
          "description": "Average phenotype z-score across guides targeting the genomic element"
        },
        "p_value": {
          "type": "number",
          "description": "P-value for the element's association with the screened phenotype."
        },
        "neg_log10_pvalue": {
          "type": "number",
          "description": "Negative log 10 p-value of the measurement or prediction"
        },
        "significant": {
          "type": "boolean",
          "description": "Boolean indicator of the significance of the element's effect on the phenotype."
        },
        "num_guides": {
          "type": "number",
          "description": "Number of guides targeting the pertubed element in the screen."
        },
        "num_guides_hit": {
          "type": "number",
          "description": "Number of guides that met hit thresholds"
        },
        "num_guides_nonhit": {
          "type": "number",
          "description": "Number of guides that did not meet hit thresholds"
        },
        "fraction_guides_hit": {
          "type": "number",
          "description": "Fraction of guides that met hit thresholds"
        },
        "method": {
          "enum": [
            "CRISPR screen"
          ]
        },
        "crispr_modality": {
          "enum": [
            "interference"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "label": {
          "enum": [
            "regulatory element effect on phenotype"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI5135QZCS/",
          "pattern": "^https://data.igvf.org/tabular-files/"
        },
        "biological_context": {
          "example": "human HFF-1 cell line from donor(s) IGVFDO0058YJWC"
        },
        "biosample_term": {
          "example": "ontology_terms/CLO_0003730"
        },
        "name": {
          "enum": [
            "associated with"
          ]
        },
        "inverse_name": {
          "enum": [
            "associated with"
          ]
        }
      },
      "required": [
        "_key",
        "z_score",
        "p_value",
        "neg_log10_pvalue",
        "significant",
        "num_guides",
        "num_guides_hit",
        "num_guides_nonhit",
        "fraction_guides_hit",
        "files_filesets",
        "crispr_modality",
        "biological_context",
        "biosample_term"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "filter_by_range": "z_score, p_value, neg_log10_pvalue",
    "return": "class, label, method, crispr_modality, source, source_url, files_filesets, biological_context, biosample_term, z_score, p_value, neg_log10_pvalue, significant, num_guides, num_guides_hit, num_guides_nonhit, fraction_guides_hit"
  },
  "db_collection_name": "genomic_elements_phenotypes"
}
