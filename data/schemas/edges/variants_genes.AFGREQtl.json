{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/variants_genes.AFGREQtl.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "SHA-256 hash of the variant key, Ensembl gene ID and dataset identifier."
        },
        "_from": {
          "example": "variants/NC_000001.11:10000:T:A",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "genes/ENSG00000187583",
          "pattern": "^genes/ENSG[0-9]{11}(?:_PAR_Y)?$",
          "collections": [
            "genes"
          ]
        },
        "biological_context": {
          "enum": [
            "lymphoblastoid cell line"
          ]
        },
        "biosample_term": {
          "enum": [
            "ontology_terms/EFO_0005292"
          ]
        },
        "chr": {
          "type": "string",
          "description": "Chromosome of the variant, prefixed with chr. Scaffolds and patch regions use UCSC-style names.",
          "example": "chr1",
          "pattern": "^chr"
        },
        "neg_log10_pvalue": {
          "type": "number",
          "description": "Negative log 10 p-value of the measurement or prediction"
        },
        "p_value": {
          "type": "number",
          "description": "Nominal p-value of association between the variant and gene expression, from the African-population meta-analysis."
        },
        "effect_size": {
          "type": "number",
          "description": "Regression coefficient (beta) of the alternate allele on gene expression."
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "enum": [
            "eQTL"
          ]
        },
        "label": {
          "enum": [
            "eQTL"
          ]
        },
        "source": {
          "enum": [
            "AFGR"
          ]
        },
        "source_url": {
          "enum": [
            "https://github.com/smontgomlab/AFGR"
          ]
        },
        "name": {
          "enum": [
            "modulates expression of"
          ]
        },
        "inverse_name": {
          "enum": [
            "expression modulated by"
          ]
        },
        "biological_process": {
          "type": "string",
          "description": "Gene Ontology term for regulation of gene expression.",
          "enum": [
            "ontology_terms/GO_0010468"
          ]
        }
      },
      "required": [
        "_key",
        "chr",
        "neg_log10_pvalue",
        "p_value",
        "effect_size",
        "biological_context",
        "biosample_term",
        "biological_process",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "variants_genes",
  "accessible_via": {
    "filter_by_range": "neg_log10_pvalue, effect_size",
    "simplified_return": "class, method, label, source, neg_log10_pvalue, biological_context",
    "return": "chr, neg_log10_pvalue, p_value, effect_size, source, class, method, label, source_url, files_filesets, biological_context, biosample_term"
  }
}
