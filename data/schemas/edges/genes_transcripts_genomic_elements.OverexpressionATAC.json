{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/genes_transcripts_genomic_elements.OverexpressionATAC.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Overexpressed gene-transcript, readout peak and source file identifier."
        },
        "_from": {
          "type": "string",
          "pattern": "^genes_transcripts/[^/]+$",
          "collections": [
            "genes_transcripts"
          ],
          "description": "Gene-to-transcript edge for the overexpressed construct.",
          "example": "genes_transcripts/ENSG00000123685_ENST00000243440"
        },
        "_to": {
          "type": "string",
          "pattern": "^genomic_elements/[^/]+$",
          "collections": [
            "genomic_elements"
          ],
          "example": "genomic_elements/ATAC_chr1_10002_10616_GRCh38_IGVFFI2320OTYL"
        },
        "log2FC": {
          "$ref": "../mixins.json#/log2FC",
          "type": [
            "number",
            "null"
          ],
          "description": "DESeq2 log2 fold change in chromatin accessibility for overexpressed gene versus control."
        },
        "stat": {
          "title": "DESeq2 Test Statistic",
          "type": ["number", "null"],
          "description": "DESeq2 test statistic reported in the source stat column."
        },
        "base_mean": {
          "title": "Base DESeq2 mean",
          "type": [
            "number",
            "null"
          ],
          "description": "DESeq2 mean normalized peak counts across samples."
        },
        "p_value": {
          "$ref": "../mixins.json#/p_value",
          "type": [
            "number",
            "null"
          ],
          "description": "Unadjusted DESeq2 p-value for differential peak accessibility."
        },
        "p_value_adj": {
          "$ref": "../mixins.json#/p_value_adj",
          "type": [
            "number",
            "null"
          ],
          "description": "DESeq2 Benjamini-Hochberg adjusted p-value."
        },
        "neg_log10_pvalue": {
          "$ref": "../mixins.json#/neg_log10_pvalue",
          "type": [
            "number",
            "null"
          ]
        },
        "neg_log10_pvalue_adj": {
          "$ref": "../mixins.json#/neg_log10_pvalue_adj",
          "type": [
            "number",
            "null"
          ]
        },
        "significant": {
          "title": "Significant?",
          "type": "boolean",
          "description": "Whether the adjusted p-value is below 0.05."
        },
        "method": {
          "enum": [
            "ATAC-seq"
          ]
        },
        "perturbation": {
          "$ref": "../mixins.json#/perturbation",
          "enum": [
            "ORF overexpression"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "label": {
          "enum": [
            "gene overexpression effect on chromatin accessibility"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI2320OTYL/",
          "pattern": "^https://data.igvf.org/tabular-files/"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        },
        "treatments_term_ids": {
          "$ref": "../mixins.json#/treatments_term_ids"
        },
        "name": {
          "enum": [
            "modulates accessibility of"
          ]
        },
        "inverse_name": {
          "enum": [
            "accessibility modulated by"
          ]
        },
        "standard_error": {
          "title": "Standard Error",
          "type": [
            "number",
            "null"
          ],
          "description": "DESeq2 standard error of log2FC."
        }
      },
      "required": [
        "_key",
        "log2FC",
        "significant",
        "perturbation",
        "files_filesets",
        "biological_context",
        "biosample_term",
        "treatments_term_ids"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "filter_by_range": "log2FC, p_value, p_value_adj, neg_log10_pvalue, neg_log10_pvalue_adj, base_mean",
    "return": "class, label, name, method, perturbation, source, source_url, files_filesets, biological_context, biosample_term, treatments_term_ids, log2FC, standard_error, stat, base_mean, p_value, p_value_adj, neg_log10_pvalue, neg_log10_pvalue_adj, significant"
  },
  "db_collection_name": "genes_transcripts_genomic_elements"
}
