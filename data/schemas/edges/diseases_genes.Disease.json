{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/diseases_genes.Disease.json",
  "accessible_via": {
    "return": "pmids, term_name, gene_symbol, association_type, association_status, class, method, label, files_filesets, source, source_url"
  },
  "db_collection_name": "diseases_genes",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "description": "Orphanet disease term key and Ensembl gene ID joined by an underscore.",
          "example": "Orphanet_166024_ENSG00000166813"
        },
        "_from": {
          "description": "Handle of the Orphanet disease term.",
          "pattern": "^ontology_terms/Orphanet_",
          "collections": [
            "ontology_terms"
          ],
          "example": "ontology_terms/Orphanet_166024"
        },
        "_to": {
          "description": "Handle of the Ensembl gene Orphanet associates with the disease.",
          "pattern": "^genes/ENSG[0-9]{11}(?:_PAR_Y)?$",
          "collections": [
            "genes"
          ],
          "example": "genes/ENSG00000166813"
        },
        "name": {
          "enum": [
            "associated_with"
          ],
          "example": "associated_with"
        },
        "inverse_name": {
          "enum": [
            "associated_with"
          ],
          "example": "associated_with"
        },
        "pmids": {
          "title": "PubMed IDs",
          "type": "array",
          "description": "Pubmed identifiers.",
          "items": {
            "type": "string"
          },
          "example": [
            "22587682"
          ]
        },
        "term_name": {
          "title": "Term Name",
          "type": "string",
          "description": "Ontology term name.",
          "example": "Multiple epiphyseal dysplasia, Al-Gazali type"
        },
        "gene_symbol": {
          "title": "Gene Symbol",
          "type": "string",
          "description": "HGNC symbol of the associated gene.",
          "example": "KIF7"
        },
        "association_type": {
          "title": "Association Type",
          "type": "string",
          "description": "Orphanet label for the role of the gene in the disease.",
          "example": "Disease-causing germline mutation(s) in"
        },
        "association_status": {
          "title": "Association Status",
          "type": "string",
          "description": "Orphanet status of the gene–disease relationship (Assessed or Confirmed)",
          "example": "Assessed"
        },
        "source": {
          "enum": [
            "Orphanet"
          ]
        },
        "source_url": {
          "enum": [
            "https://www.orphadata.com/genes/"
          ]
        }
      },
      "required": [
        "pmids",
        "term_name",
        "gene_symbol",
        "association_type",
        "association_status",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
