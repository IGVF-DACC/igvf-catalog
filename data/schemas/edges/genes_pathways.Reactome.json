{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/genes_pathways.Reactome.json",
  "accessible_via": {
    "return": "source, source_url, organism, class, method, label, files_filesets"
  },
  "db_collection_name": "genes_pathways",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "$ref": "../mixins.json#/organism"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/properties/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Ensembl gene ID and Reactome pathway ID joined by an underscore.",
          "example": "ENSG00000290825_R-HSA-1971475"
        },
        "_from": {
          "example": "genes/ENSG00000290825",
          "pattern": "^genes/ENSG[0-9]{11}(?:_PAR_Y)?$",
          "collections": [
            "genes"
          ]
        },
        "_to": {
          "example": "pathways/R-HSA-1971475",
          "pattern": "^pathways/R-HSA-[0-9]+$",
          "collections": [
            "pathways"
          ]
        },
        "source": {
          "enum": [
            "Reactome"
          ]
        },
        "source_url": {
          "enum": [
            "https://reactome.org/"
          ]
        },
        "name": {
          "enum": [
            "belongs to"
          ],
          "example": "belongs to"
        },
        "inverse_name": {
          "enum": [
            "has part"
          ],
          "example": "has part"
        },
        "organism": {
          "enum": [
            "Homo sapiens"
          ]
        },
        "class": {
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "_key",
        "organism",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
