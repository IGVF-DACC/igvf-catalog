{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_drugs_genes.PharmGKB.json",
  "accessible_via": {
    "return": "_id, name, inverse_name, gene_symbol, source, source_url, class, method, files_filesets"
  },
  "db_collection_name": "variants_drugs_genes",
  "allOf": [
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        }
      }
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "PharmGKB variant annotation ID, drug accession and Ensembl gene ID joined by underscores.",
          "example": "1450377668_PA450373_ENSG00000165841"
        },
        "_from": {
          "type": "string",
          "description": "Document handle of the source node, in collection/key form.",
          "pattern": "^variants_drugs/",
          "collections": [
            "variants_drugs"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Document handle of the target node, in collection/key form.",
          "pattern": "^genes/ENSG[0-9]{11}(?:_PAR_Y)?$",
          "collections": [
            "genes"
          ]
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "associated with"
          ]
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "associated with"
          ]
        },
        "gene_symbol": {
          "type": "string",
          "description": "HGNC symbol of the gene this edge attaches to the variant-drug annotation.",
          "example": "ABCB1"
        },
        "source": {
          "type": "string",
          "enum": [
            "pharmGKB"
          ]
        },
        "source_url": {
          "type": "string",
          "example": "https://www.pharmgkb.org/variantAnnotation/1451159680",
          "pattern": "^https://www\\.pharmgkb\\.org/variantAnnotation/"
        },
        "class": {
          "type": "string",
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "PharmGKB"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI8835SMSP",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "name",
        "inverse_name",
        "gene_symbol",
        "source",
        "source_url",
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
