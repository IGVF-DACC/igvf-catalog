{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/complexes_proteins.EBIComplex.json",
  "accessible_via": {
    "return": "stoichiometry, chain_id, isoform_id, number_of_paralogs, linked_features, class, method, label, files_filesets, source, source_url"
  },
  "db_collection_name": "complexes_proteins",
  "allOf": [
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "label": {
          "$ref": "../mixins.json#/classification/label"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Complex accession and Ensembl protein ID joined by an underscore.",
          "example": "CPX-2428_ENSP00000372925"
        },
        "_from": {
          "type": "string",
          "description": "Document handle of the source node, in collection/key form.",
          "example": "complexes/CPX-2428",
          "pattern": "^complexes/",
          "collections": [
            "complexes"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Document handle of the target node, in collection/key form.",
          "example": "proteins/ENSP00000372925",
          "pattern": "^proteins/",
          "collections": [
            "proteins"
          ]
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "example": "contains"
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "example": "belongs to"
        },
        "stoichiometry": {
          "type": "integer",
          "description": "Number of copies of this protein in the complex. 0 means the stoichiometry is unknown.",
          "example": 1
        },
        "chain_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "UniProt chain identifier when the participant is a specific processed chain rather than the full protein. Null otherwise."
        },
        "isoform_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "UniProt isoform number when the participant is a specific isoform. Null otherwise."
        },
        "number_of_paralogs": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Count of interchangeable paralogs when this participant is a molecule set. Null for a single protein."
        },
        "paralogs": {
          "type": [
            "array",
            "null"
          ],
          "description": "UniProt accessions of the interchangeable paralogs when this participant is a molecule set. Null for a single protein.",
          "example": [
            "O15342",
            "Q8NHE4"
          ]
        },
        "linked_features": {
          "type": "array",
          "description": "Binding regions between this protein and other participants of the complex, taken from the Complex Portal API: each entry names a participant and the residue ranges involved.",
          "example": [
            {
              "participantId": "proteins/ENSP00000365025",
              "ranges": [
                "?-?"
              ]
            },
            {
              "participantId": "proteins/ENSP00000365026",
              "ranges": [
                "?-?"
              ]
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "EBI"
          ]
        },
        "source_url": {
          "type": "string",
          "enum": [
            "https://www.ebi.ac.uk/complexportal/"
          ]
        },
        "class": {
          "type": "string"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI1444TRQL",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "name",
        "inverse_name",
        "stoichiometry",
        "chain_id",
        "isoform_id",
        "number_of_paralogs",
        "paralogs",
        "linked_features",
        "source",
        "source_url",
        "class",
        "method",
        "label",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
