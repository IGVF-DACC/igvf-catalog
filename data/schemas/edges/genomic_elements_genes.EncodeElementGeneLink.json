{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/genomic_elements_genes.EncodeElementGeneLink.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Genomic element key, Ensembl gene ID and source file accession joined by underscores.",
          "example": "intergenic_chr1_778465_778965_GRCh38_ENSG00000225880_ENCFF003BKC"
        },
        "_from": {
          "example": "genomic_elements/intergenic_chr1_778465_778965_GRCh38_ENCFF003BKC",
          "pattern": "^genomic_elements/",
          "collections": [
            "genomic_elements"
          ]
        },
        "_to": {
          "example": "genes/ENSG00000225880",
          "pattern": "^genes/",
          "collections": [
            "genes"
          ]
        },
        "method": {
          "enum": [
            "ENCODE-rE2G"
          ]
        },
        "label": {
          "enum": [
            "predicted regulatory element effect on gene expression"
          ]
        },
        "class": {
          "enum": [
            "prediction"
          ]
        },
        "score": {
          "type": "number",
          "description": "ENCODE-rE2G score: Probability that the element has a regulatory effect on the target gene."
        },
        "source": {
          "enum": [
            "ENCODE"
          ]
        },
        "source_url": {
          "example": "https://www.encodeproject.org/files/ENCFF003BKC/",
          "pattern": "^https://www.encodeproject.org/files/"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context",
          "example": "head of caudate nucleus from ENCDO948PMW"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term",
          "example": "ontology_terms/UBERON_0002626"
        },
        "treatments_term_ids": {
          "$ref": "../mixins.json#/treatments_term_ids",
          "example": [
            "UniProtKB:P05112"
          ]
        },
        "name": {
          "enum": [
            "regulates"
          ]
        },
        "inverse_name": {
          "enum": [
            "regulated by"
          ]
        }
      },
      "required": [
        "_key",
        "score",
        "files_filesets",
        "biological_context",
        "biosample_term",
        "treatments_term_ids"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "filter_by_range": "score",
    "return": "class, label, method, source, source_url, files_filesets, biological_context, biosample_term, score"
  },
  "db_collection_name": "genomic_elements_genes"
}
