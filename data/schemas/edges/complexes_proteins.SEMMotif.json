{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/complexes_proteins.SEMMotif.json",
  "db_collection_name": "complexes_proteins",
  "allOf": [
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/source_url"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "title": "Document Key",
          "type": "string",
          "description": "The 'SEMpl_'-prefixed complex key and the Ensembl protein ID, joined by an underscore."
        },
        "_from": {
          "title": "Source Node",
          "type": "string",
          "description": "Document handle of the transcription factor complex.",
          "pattern": "^complexes/SEMpl_",
          "collections": [
            "complexes"
          ],
          "example": "complexes/SEMpl_TAL1:TCF4"
        },
        "_to": {
          "title": "Target Node",
          "type": "string",
          "description": "Document handle of one protein subunit of that complex.",
          "pattern": "^proteins/",
          "collections": [
            "proteins"
          ]
        },
        "name": {
          "title": "Name",
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "contains"
          ]
        },
        "inverse_name": {
          "title": "Inverse Name",
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "belongs to"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/model-files/IGVFFI9967LYCS",
          "pattern": "^https://data.igvf.org/model-files/"
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "name",
        "inverse_name",
        "source",
        "source_url"
      ],
      "additionalProperties": false
    }
  ]
}
