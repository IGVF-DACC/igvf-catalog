{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_biosamples.BlueSTARRVariantBiosample.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "$ref": "../mixins.json#/provenance"
    },
    {
      "$ref": "../mixins.json#/classification"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/properties/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/file_metadata/properties/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/file_metadata/properties/biosample_term"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Variant key, biosample ontology term and source file accession joined by underscores."
        },
        "_from": {
          "example": "variants/NC_000005.10:1779518:G:A",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "ontology_terms/c003f2e98a5817b37ce38ee6d199b560bdcc497f30973e8689b16ba75944465c",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "genomic_element": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference to the candidate cis-regulatory element the variant falls in; null when the source file has no linked cCREs.",
          "example": "genomic_elements/candidate_cis_regulatory_element_chr10_10457_10458_GRCh38_ENCFF420VPZ",
          "pattern": "^genomic_elements/",
          "collections": [
            "genomic_elements"
          ]
        },
        "log2FC": {
          "type": "number",
          "description": "log2 fold change in STARR-seq reporter activity."
        },
        "class": {
          "enum": [
            "prediction"
          ]
        },
        "label": {
          "enum": [
            "predicted variant effect on gene expression"
          ]
        },
        "method": {
          "enum": [
            "BlueSTARR"
          ]
        },
        "name": {
          "enum": [
            "modulates regulatory activity of"
          ]
        },
        "inverse_name": {
          "enum": [
            "regulatory activity modulated by"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "enum": [
            "https://data.igvf.org/tabular-files/IGVFFI3351LASN/",
            "https://data.igvf.org/tabular-files/IGVFFI1663LKVQ/",
            "https://data.igvf.org/tabular-files/IGVFFI5288RAAV/",
            "https://data.igvf.org/tabular-files/IGVFFI0818FMCC/"
          ]
        }
      },
      "required": [
        "_key",
        "genomic_element",
        "log2FC",
        "biological_context",
        "biosample_term",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "variants_biosamples"
}
