{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edge.base.json",
  "title": "Edge Node Schema",
  "description": "Base schema for all edge types in the IGVF Catalog. Defines common required properties.",
  "allOf": [
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "label": {
          "$ref": "../mixins.json#/classification/label"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_from": {
          "type": "string",
          "description": "Document handle of the source node, in collection/key form."
        },
        "_to": {
          "type": "string",
          "description": "Document handle of the target node, in collection/key form."
        },
        "label": {
          "type": "string",
          "example": "eQTL"
        },
        "class": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "example": "MPRA"
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "example": "modulates expression of"
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "example": "expression modulated by"
        },
        "source": {
          "type": "string",
          "example": "IGVF"
        },
        "source_url": {
          "type": "string"
        }
      },
      "required": [
        "_from",
        "_to",
        "label",
        "class",
        "method",
        "name",
        "inverse_name",
        "source",
        "source_url"
      ],
      "additionalProperties": false
    }
  ]
}
