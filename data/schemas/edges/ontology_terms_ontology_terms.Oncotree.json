{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/ontology_terms_ontology_terms.Oncotree.json",
  "db_collection_name": "ontology_terms_ontology_terms",
  "allOf": [
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Source term key, the relationship predicate and the target term key, joined by underscores.",
          "example": "Oncotree_MMB_rdf-schema.subClassOf_Oncotree_EMBT"
        },
        "_from": {
          "type": "string",
          "description": "Handle of the source OncoTree term.",
          "example": "ontology_terms/Oncotree_MMB",
          "pattern": "^ontology_terms/Oncotree_",
          "collections": [
            "ontology_terms"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Handle of the parent OncoTree term, or of the NCIT cross-reference.",
          "example": "ontology_terms/Oncotree_EMBT",
          "pattern": "^ontology_terms/Oncotree_|^ontology_terms/NCIT_",
          "collections": [
            "ontology_terms"
          ]
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "subclass",
            "database cross-reference"
          ]
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "type of",
            "database cross-reference"
          ]
        },
        "type": {
          "type": "string",
          "description": "Subclass of the parent tumor type, or database cross-reference to NCIT.",
          "enum": [
            "subclass",
            "database cross-reference"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "Oncotree"
          ]
        },
        "class": {
          "type": "string",
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI4975UFZM",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "name",
        "inverse_name",
        "type",
        "source",
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
