{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/coding_variants_phenotypes.VariantPaintingAdapter.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Coding variant key, phenotype ontology term and source file accession, joined by underscores."
        },
        "_from": {
          "example": "coding_variants/coding_var_1",
          "pattern": "^coding_variants/",
          "collections": [
            "coding_variants"
          ]
        },
        "_to": {
          "example": "ontology_terms/phenotype_1",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI9499PJFU",
          "pattern": "^https://data.igvf.org/tabular-files/"
        },
        "name": {
          "enum": [
            "mutational effect"
          ]
        },
        "inverse_name": {
          "enum": [
            "altered due to mutation"
          ]
        },
        "biological_context": {
          "example": "U2OS"
        },
        "biosample_term": {
          "example": "ontology_terms/EFO_0002869"
        },
        "method": {
          "enum": [
            "Variant painting via fluorescence"
          ]
        },
        "label": {
          "enum": [
            "protein variant effect"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "localization_score": {
          "type": "number",
          "description": "XGBoost classifier score measuring the probability of protein mislocalization caused by the variant"
        },
        "mislocalization_hit": {
          "type": "boolean",
          "description": "Whether the variant is classified as causing protein mislocalization based on the localization score threshold"
        }
      },
      "required": [
        "_key",
        "files_filesets",
        "biosample_term",
        "biological_context",
        "localization_score",
        "mislocalization_hit"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "coding_variants_phenotypes"
}
