{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_biosamples.ColocBoostVariantBiosample.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Unique identifier for the variant to biosample edge"
        },
        "_from": {
          "example": "variants/NC_000001.11:100:G:A",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "ontology_terms/UBERON_0001323",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "biosample_term": {
          "type": "string",
          "description": "Ontology term reference for the biosample",
          "pattern": "^ontology_terms/"
        },
        "biological_context": {
          "type": "string",
          "description": "Biosample name from GTEx(e.g. tibial nerve)"
        },
        "phenotype": {
          "type": "string",
          "description": "Ontology term reference for the associated phenotype or disease trait from GWAS",
          "pattern": "^ontology_terms/"
        },
        "vcp": {
          "type": "number",
          "description": "Variant Colocalization Probability (0–1)"
        },
        "gene": {
          "type": "string",
          "description": "ArangoDB reference to the gene associated with the colocalization",
          "pattern": "^genes/",
          "collections": ["genes"]
        },
        "trait_name": {
          "type": "string",
          "description": "Name of the associated disease or trait"
        },
        "label": {
          "enum": [
            "predicted variant effect on phenotype"
          ]
        },
        "method": {
          "enum": [
            "ColocBoost"
          ]
        },
        "class": {
          "enum": [
            "prediction"
          ]
        },
        "name": {
          "enum": [
            "colocalizes with"
          ]
        },
        "inverse_name": {
          "enum": [
            "colocalized by variant"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://data.igvf.org/tabular-files/"
        },
        "files_filesets": {
          "type": "string",
          "description": "Fileset reference for this colocalization result",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "_key",
        "biosample_term",
        "biological_context",
        "phenotype",
        "vcp",
        "gene",
        "trait_name",
        "source_url",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "variants_biosamples"
}
