{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "schemas/edges/variants_proteins.pQTL.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "label": {
          "$ref": "../mixins.json#/classification/label"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/file_metadata/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/file_metadata/biosample_term"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Variant key, Ensembl protein ID and the source name joined by underscores.",
          "example": "NC_000017.11:7166092:G:A_ENSP00000491556_UKB"
        },
        "_from": {
          "example": "variants/NC_000017.11:7166092:G:A",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "proteins/ENSP00000491556",
          "pattern": "^proteins/",
          "collections": [
            "proteins"
          ]
        },
        "rsid": {
          "type": [
            "string",
            "null"
          ],
          "description": "dbSNP id for the variant position",
          "example": "rs1260326"
        },
        "label": {
          "enum": [
            "pQTL"
          ]
        },
        "neg_log10_pvalue": {
          "type": "number",
          "description": "Negative log 10 p-value of the measurement or prediction"
        },
        "beta": {
          "type": "number",
          "description": "Discovery-cohort effect size of allele A1 on plasma protein level."
        },
        "se": {
          "type": "number",
          "description": "Standard error of the discovery-cohort beta."
        },
        "regulatory_type": {
          "type": "string",
          "description": "Whether the association is cis (within 1 Mb of the gene encoding the protein) or trans.",
          "enum": [
            "cis",
            "trans"
          ]
        },
        "gene": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ensembl gene the source annotates at this locus, as a handle into genes. Null when the annotation is missing or the identifier is not in the catalog.",
          "example": "genes/ENSG00000165841"
        },
        "gene_consequence": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sequence Ontology consequence of the variant on the annotated gene. Null when none is recorded.",
          "example": "intergenic_variant"
        },
        "biological_context": {
          "enum": [
            "blood plasma"
          ]
        },
        "biosample_term": {
          "enum": [
            "ontology_terms/UBERON_0001969"
          ]
        },
        "source": {
          "enum": [
            "UKB"
          ]
        },
        "source_url": {
          "enum": [
            "https://metabolomips.org/ukbbpgwas/"
          ]
        },
        "name": {
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "associated with levels of"
          ]
        },
        "inverse_name": {
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "level associated with"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "enum": [
            "pQTL"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI2053GDNI",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "_key",
        "rsid",
        "neg_log10_pvalue",
        "beta",
        "se",
        "gene",
        "gene_consequence",
        "biological_context",
        "biosample_term",
        "regulatory_type",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "name": "variants_proteins",
    "return": "label, neg_log10_pvalue, beta, se, gene, gene_consequence, source, source_url, method, class, regulatory_type, files_filesets"
  },
  "db_collection_name": "variants_proteins"
}
