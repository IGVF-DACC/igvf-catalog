{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_phenotypes.CRISPRVariantPhenotype.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "label": {
          "$ref": "../mixins.json#/classification/label"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        },
        "crispr_modality": {
          "$ref": "../mixins.json#/assay_metadata/crispr_modality"
        }
      }
    },
    {
      "properties": {
        "$ref": "../mixins.json#/file_metadata"
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Variant key, phenotype ontology term and source file accession joined by underscores.",
          "example": "NC_000001.11:25253603:G:A_NTR_0001118_IGVFFI2014OOZP"
        },
        "_from": {
          "example": "variants/NC_000001.11:25253603:G:A",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "ontology_terms/NTR_0001118",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "effect_size": {
          "type": "number",
          "description": "Estimated phenotype effect size (mu or mu_adj)"
        },
        "z_score": {
          "type": "number",
          "description": "Z-score of the variant's effect size, as the posterior mean over its uncertainty. Files that calibrate against the negative-control variants report the adjusted z-score (mu_z_adj) instead of the raw one."
        },
        "significant": {
          "type": "boolean",
          "description": "Boolean indicator of the significance of the variant effect on the phenotype."
        },
        "num_guides": {
          "type": [
            "number",
            "null"
          ],
          "description": "Number of guides aggregated across the variant in the screen."
        },
        "edit_rate_mean": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean effective prime-editing rate across the variant's guides: the fraction of cells edited, from 0 to 1."
        },
        "effect_size_ci95_lower": {
          "type": [
            "number",
            "null"
          ],
          "description": "Lower bound of the 95% confidence interval for effect size."
        },
        "effect_size_ci95_upper": {
          "type": [
            "number",
            "null"
          ],
          "description": "Upper bound of the 95% confidence interval for effect size."
        },
        "method": {
          "enum": [
            "CRISPR screen"
          ]
        },
        "crispr_modality": {
          "type": "string",
          "enum": [
            "prime editing"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "label": {
          "enum": [
            "variant effect on phenotype"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI2014OOZP/",
          "pattern": "^https://data.igvf.org/tabular-files/"
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI2014OOZP",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        },
        "biological_context": {
          "example": "human HCT116 cell line from donor(s) IGVFDO0384OZRW"
        },
        "biosample_term": {
          "example": "ontology_terms/EFO_0002824",
          "pattern": "^ontology_terms/"
        },
        "name": {
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "associated with"
          ]
        },
        "inverse_name": {
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "associated with"
          ]
        }
      },
      "required": [
        "_key",
        "effect_size",
        "z_score",
        "significant",
        "num_guides",
        "edit_rate_mean",
        "effect_size_ci95_lower",
        "effect_size_ci95_upper",
        "files_filesets",
        "crispr_modality",
        "biological_context",
        "biosample_term"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "filter_by_range": "effect_size, z_score",
    "return": "name, class, label, method, crispr_modality, source, source_url, files_filesets, biological_context, biosample_term, effect_size, z_score, significant, num_guides, edit_rate_mean, effect_size_ci95_lower, effect_size_ci95_upper"
  },
  "db_collection_name": "variants_phenotypes"
}
