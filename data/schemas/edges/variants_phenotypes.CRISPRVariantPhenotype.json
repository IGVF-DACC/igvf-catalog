{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_phenotypes.CRISPRVariantPhenotype.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Unique identifier for the variant to phenotype edge",
          "example": "NC_000001.11:25253603:G:A_NTR_0001118_IGVFFI7160EKDK"
        },
        "_from": {
          "example": "variants/NC_000001.11:25253603:G:A",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "ontology_terms/NTR_0001118",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "effect_size": {
          "type": "number",
          "description": "Estimated phenotype effect size (mu/mu_adj or beta)"
        },
        "z_score": {
          "type": "number",
          "description": "Phenotype association z-score"
        },
        "p_value": {
          "type": [
            "number",
            "null"
          ],
          "description": "Phenotype association p-value when provided by the source file"
        },
        "fdr": {
          "type": [
            "number",
            "null"
          ],
          "description": "False discovery rate when provided by the source file"
        },
        "neg_log10_pvalue": {
          "type": [
            "number",
            "null"
          ],
          "description": "Negative log10 of the phenotype p-value"
        },
        "neg_log10_fdr": {
          "type": [
            "number",
            "null"
          ],
          "description": "Negative log10 of the FDR"
        },
        "significant": {
          "type": "boolean",
          "description": "Whether the variant met the significance threshold for the phenotype. FDR or p-value < 0.05 when available; otherwise whether the 95% CI excludes 0."
        },
        "num_guides": {
          "type": [
            "number",
            "null"
          ],
          "description": "Number of guides targeting the variant."
        },
        "edit_rate_mean": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean editing rate."
        },
        "edit_rate_standard_deviation": {
          "type": [
            "number",
            "null"
          ],
          "description": "Standard deviation of editing rate."
        },
        "effect_size_ci95_lower": {
          "type": [
            "number",
            "null"
          ],
          "description": "Lower bound of the 95% confidence interval for effect size."
        },
        "effect_size_ci95_upper": {
          "type": [
            "number",
            "null"
          ],
          "description": "Upper bound of the 95% confidence interval for effect size."
        },
        "method": {
          "enum": [
            "CRISPR screen"
          ]
        },
        "crispr_modality": {
          "type": "string",
          "description": "The CRISPR modality from the associated files_filesets record",
          "enum": [
            "interference",
            "base editing",
            "prime editing",
            "activation",
            "knockout"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "label": {
          "enum": [
            "variant effect on phenotype"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://api.data.igvf.org/tabular-files/IGVFFI7160EKDK/",
          "pattern": "^https://api.data.igvf.org/tabular-files/"
        },
        "files_filesets": {
          "type": "string",
          "description": "The filesets of the variant to phenotype edge",
          "example": "files_filesets/IGVFFI7160EKDK",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        },
        "biological_context": {
          "type": "string",
          "description": "The biological context of the variant to phenotype edge",
          "example": "Homo sapiens HepG2 cell line"
        },
        "biosample_term": {
          "type": "string",
          "description": "The biosample term of the variant to phenotype edge",
          "example": "ontology_terms/EFO_0001187",
          "pattern": "^ontology_terms/"
        },
        "treatments_term_ids": {
          "type": [
            "array",
            "null"
          ],
          "description": "The treatments term ids of the variant to phenotype edge"
        },
        "name": {
          "enum": [
            "associated with"
          ]
        },
        "inverse_name": {
          "enum": [
            "associated with"
          ]
        }
      },
      "required": [
        "_key",
        "effect_size",
        "z_score",
        "p_value",
        "fdr",
        "neg_log10_pvalue",
        "neg_log10_fdr",
        "significant",
        "num_guides",
        "edit_rate_mean",
        "edit_rate_standard_deviation",
        "effect_size_ci95_lower",
        "effect_size_ci95_upper",
        "files_filesets",
        "crispr_modality",
        "biological_context",
        "biosample_term"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "filter_by_range": "effect_size, z_score, p_value, fdr, neg_log10_pvalue, neg_log10_fdr",
    "return": "class, label, method, crispr_modality, source, source_url, files_filesets, biological_context, biosample_term, effect_size, z_score, p_value, fdr, neg_log10_pvalue, neg_log10_fdr, significant, num_guides, edit_rate_mean, edit_rate_standard_deviation, effect_size_ci95_lower, effect_size_ci95_upper"
  },
  "db_collection_name": "variants_phenotypes"
}
