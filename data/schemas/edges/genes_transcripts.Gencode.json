{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/genes_transcripts.Gencode.json",
  "accessible_via": {
    "return": "_id, source, version, source_url"
  },
  "db_collection_name": "genes_transcripts",
  "allOf": [
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/source_url"
        },
        "organism": {
          "$ref": "../mixins.json#/organism"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Ensembl gene ID and Ensembl transcript ID joined by an underscore.",
          "example": "ENSG00000290825_ENST00000456328"
        },
        "_from": {
          "type": "string",
          "description": "Document handle of the gene.",
          "example": "genes/ENSG00000290825",
          "pattern": "^(genes/ENSG[0-9]{11}(?:_PAR_Y)?|mm_genes/ENSMUSG[0-9]{11}(?:_PAR_Y)?)$",
          "collections": [
            "genes",
            "mm_genes"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Document handle of a transcript of that gene.",
          "example": "transcripts/ENST00000456328",
          "pattern": "^(transcripts/ENST[0-9]{11}(?:_PAR_Y)?|mm_transcripts/ENSMUST[0-9]{11}(?:_PAR_Y)?)$",
          "collections": [
            "transcripts",
            "mm_transcripts"
          ]
        },
        "source": {
          "enum": [
            "GENCODE"
          ]
        },
        "version": {
          "title": "Version",
          "type": "string",
          "description": "GENCODE release the annotation was taken from.",
          "enum": [
            "v43",
            "vM36"
          ]
        },
        "source_url": {
          "example": "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_43/gencode.v43.chr_patch_hapl_scaff.annotation.gtf.gz"
        },
        "name": {
          "title": "Name",
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "transcribes"
          ]
        },
        "inverse_name": {
          "title": "Inverse Name",
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "transcribed by"
          ]
        },
        "organism": {
          "enum": [
            "Homo sapiens",
            "Mus musculus"
          ]
        },
        "biological_process": {
          "title": "Biological Process",
          "type": "string",
          "description": "Gene Ontology term for the process this edge represents. GO_0010467 is 'gene expression'.",
          "enum": [
            "ontology_terms/GO_0010467"
          ]
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "source",
        "version",
        "source_url",
        "name",
        "inverse_name",
        "organism",
        "biological_process"
      ],
      "additionalProperties": false
    }
  ]
}
