{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/variants_genomic_elements.CAQtl.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Variant SPDI, genomic element key, source-file cell label and source file accession joined by underscores."
        },
        "_from": {
          "example": "variants/NC_000001.11:766454:T:C",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "genomic_elements/accessible_dna_element_chr1_778381_779150_GRCh38_ENCFF103XRK",
          "pattern": "^genomic_elements/",
          "collections": [
            "genomic_elements"
          ]
        },
        "rsid": {
          "type": "string",
          "description": "dbSNP id for the variant position",
          "example": "rs189800799"
        },
        "label": {
          "enum": [
            "caQTL"
          ]
        },
        "method": {
          "enum": [
            "caQTL"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "source": {
          "enum": [
            "ENCODE"
          ]
        },
        "source_url": {
          "example": "https://www.encodeproject.org/files/ENCFF103XRK/",
          "pattern": "^https://www.encodeproject.org/files/"
        },
        "biological_context": {
          "example": "neural progenitor cell"
        },
        "biosample_term": {
          "example": "ontology_terms/CL_0011020"
        },
        "name": {
          "enum": [
            "modulates accessibility of"
          ]
        },
        "inverse_name": {
          "enum": [
            "accessibility modulated by"
          ]
        },
        "method_term": {
          "type": "string",
          "description": "Ontology term for the chromatin accessibility assay.",
          "enum": [
            "ontology_terms/BAO_0040027"
          ]
        }
      },
      "required": [
        "_key",
        "rsid",
        "files_filesets",
        "biological_context",
        "biosample_term",
        "method_term"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "variants_genomic_elements"
}
