{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_genomic_elements.CAQtl.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Variant SPDI, genomic element key, source-file cell label and source file accession joined by underscores."
        },
        "_from": {
          "example": "variants/NC_000001.11:766454:T:C",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "genomic_elements/accessible_dna_element_chr1_778381_779150_GRCh38_ENCFF103XRK",
          "pattern": "^genomic_elements/",
          "collections": [
            "genomic_elements"
          ]
        },
        "rsid": {
          "type": "string",
          "description": "dbSNP reference SNP identifier of the variant.",
          "example": "rs189800799"
        },
        "label": {
          "enum": [
            "caQTL"
          ]
        },
        "method": {
          "enum": [
            "caQTL"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "source": {
          "enum": [
            "ENCODE"
          ]
        },
        "source_url": {
          "example": "https://www.encodeproject.org/files/ENCFF103XRK/",
          "pattern": "^https://www.encodeproject.org/files/"
        },
        "files_filesets": {
          "type": "string",
          "description": "Handle of the files_filesets record for the ENCODE caQTL file this edge was read from.",
          "example": "files_filesets/ENCFF103XRK",
          "pattern": "^files_filesets/"
        },
        "biological_context": {
          "type": "string",
          "description": "Cell or tissue the caQTL was measured in, as the ontology term name mapped from the source file's cell label.",
          "example": "neural progenitor cell"
        },
        "biosample_term": {
          "type": "string",
          "description": "Ontology term for the cell or tissue the caQTL was measured in.",
          "pattern": "^ontology_terms/",
          "example": "ontology_terms/CL_0011020"
        },
        "name": {
          "enum": [
            "modulates accessibility of"
          ]
        },
        "inverse_name": {
          "enum": [
            "accessibility modulated by"
          ]
        },
        "method_term": {
          "type": "string",
          "description": "BioAssay Ontology term for a chromatin accessibility assay, as a handle into ontology_terms.",
          "enum": [
            "ontology_terms/BAO_0040027"
          ]
        }
      },
      "required": [
        "_key",
        "rsid",
        "files_filesets",
        "biological_context",
        "biosample_term",
        "method_term"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "variants_genomic_elements"
}
