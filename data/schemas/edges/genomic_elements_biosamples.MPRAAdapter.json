{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/genomic_elements_biosamples.MPRAAdapter.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        },
        "treatments_term_ids": {
          "$ref": "../mixins.json#/treatments_term_ids"
        },
        "source": {
          "$ref": "../mixins.json#/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/method"
        },
        "label": {
          "$ref": "../mixins.json#/label"
        },
        "class": {
          "$ref": "../mixins.json#/class"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Genomic element key, strand token, source file accession and biosample term joined by underscores."
        },
        "_from": {
          "example": "genomic_elements/MPRA_chr1_10410_10610_GRCh38_ENCFF769REH",
          "pattern": "^genomic_elements/",
          "collections": [
            "genomic_elements"
          ]
        },
        "_to": {
          "example": "ontology_terms/UBERON_0002048",
          "pattern": "^ontology_terms/",
          "collections": [
            "ontology_terms"
          ]
        },
        "bed_score": {
          "type": "integer",
          "description": "Score column of the source BED file."
        },
        "strand": {
          "type": "string",
          "description": "Strand the tile was tested in: '+' or '-', or '.' where the reference sequence design does not record one."
        },
        "log2FC": {
          "type": "number",
          "description": "Fold change in reporter activity for the element: its normalized output (RNA) over input (DNA) ratio."
        },
        "DNA_count": {
          "type": "number",
          "description": "Input count (DNA), normalized to counts per million and averaged across replicates."
        },
        "RNA_count": {
          "type": "number",
          "description": "Output count (RNA), normalized to counts per million and averaged across replicates."
        },
        "neg_log10_pvalue": {
          "type": [
            "number",
            "null"
          ],
          "description": "Negative log 10 p-value of the measurement or prediction"
        },
        "neg_log10_pvalue_adj": {
          "type": [
            "number",
            "null"
          ],
          "description": "Adjusted negative log 10 p-value of the measurement or prediction"
        },
        "significant": {
          "type": "boolean",
          "description": "Boolean indicator of the significance of the element's activity. The threshold is: a neg_log10_pvalue_adj of 1 or more."
        },
        "label": {
          "enum": [
            "regulatory reference element activity"
          ]
        },
        "name": {
          "enum": [
            "expression effect in"
          ]
        },
        "inverse_name": {
          "enum": [
            "has expression effect from"
          ]
        },
        "method": {
          "enum": [
            "MPRA"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "source": {
          "enum": [
            "IGVF",
            "ENCODE"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI1323RCIE"
        },
        "biological_context": {
          "example": "glutamatergic neuron differentiated cell specimen, pooled cell specimen from IGVFDO6638HIAD"
        },
        "biosample_term": {
          "example": "ontology_terms/UBERON_0002048"
        }
      },
      "required": [
        "_key",
        "bed_score",
        "strand",
        "log2FC",
        "DNA_count",
        "RNA_count",
        "significant",
        "neg_log10_pvalue",
        "neg_log10_pvalue_adj",
        "files_filesets",
        "biosample_term",
        "biological_context",
        "treatments_term_ids"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "return": "_id, strand, log2FC, bed_score, DNA_count, RNA_count, significant, neg_log10_pvalue, neg_log10_pvalue_adj, source, source_url"
  },
  "db_collection_name": "genomic_elements_biosamples"
}
