{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/genes_mm_genes.MGIHumanMouseOrthologAdapter.json",
  "accessible_via": {
    "return": "_id, name, inverse_name, relationship, source, source_url, class, method, files_filesets"
  },
  "db_collection_name": "genes_mm_genes",
  "allOf": [
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        }
      }
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "The mouse and human node handles with slashes rewritten to underscores.",
          "example": "mm_genes_ENSMUSG00000024844_genes_ENSG00000175334"
        },
        "_from": {
          "type": "string",
          "description": "Handle of the human gene.",
          "example": "genes/ENSG00000175334",
          "pattern": "^genes/ENSG[0-9]{11}(?:_PAR_Y)?$",
          "collections": [
            "genes"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Handle of the mouse gene in the same MGI homology class.",
          "example": "mm_genes/ENSMUSG00000024844",
          "pattern": "^mm_genes/ENSMUSG[0-9]{11}(?:_PAR_Y)?$",
          "collections": [
            "mm_genes"
          ]
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "homologous to"
          ]
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "homologous to"
          ]
        },
        "relationship": {
          "type": "string",
          "description": "NCI Thesaurus term for a homologous gene.",
          "enum": [
            "ontology_terms/NCIT_C79968"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "MGI"
          ]
        },
        "source_url": {
          "type": "string",
          "example": "https://www.informatics.jax.org/downloads/reports/HOM_MouseHumanSequence.rpt"
        },
        "class": {
          "type": "string",
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "Homology"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI9177QQPS",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "name",
        "inverse_name",
        "relationship",
        "source",
        "source_url",
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
