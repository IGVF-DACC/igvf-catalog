{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_coding_variants.ESM1vCodingVariantsScores.json",
  "db_collection_name": "variants_coding_variants",
  "allOf": [
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/source_url"
        },
        "label": {
          "$ref": "../mixins.json#/label"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Variant key and coding variant key joined by an underscore. Hashed with SHA-256 when the composite would exceed the 254-character key limit."
        },
        "_from": {
          "type": "string",
          "description": "Document handle of the genomic variant.",
          "example": "variants/NC_000001.11:10202:C:A",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Document handle of the coding variant this genomic variant produces.",
          "example": "coding_variants/OR4F5_ENST00000641515_p.Met1!_c.1A-C",
          "pattern": "^coding_variants/",
          "collections": [
            "coding_variants"
          ]
        },
        "name": {
          "title": "Name",
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "codes for"
          ]
        },
        "inverse_name": {
          "title": "Inverse Name",
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "encoded by"
          ]
        },
        "chr": {
          "title": "Chromosome",
          "type": "string",
          "description": "Chromosome the genomic variant lies on, prefixed with 'chr'. Scaffolds and patch regions use UCSC-style names.",
          "example": "chr18"
        },
        "pos": {
          "title": "Position",
          "type": "integer",
          "description": "0-based genomic coordinate of the variant."
        },
        "ref": {
          "title": "Reference Sequence",
          "type": "string",
          "description": "Reference allele of the genomic variant.",
          "example": "CA"
        },
        "alt": {
          "title": "Alternate Sequence",
          "type": "string",
          "description": "Alternate allele of the genomic variant.",
          "example": "AC"
        },
        "label": {
          "enum": [
            "codes for"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "enum": [
            "https://data.igvf.org/tabular-files/IGVFFI8105TNNO"
          ]
        }
      },
      "required": [
        "_key",
        "chr",
        "pos",
        "ref",
        "alt",
        "label",
        "source",
        "name",
        "inverse_name",
        "_from",
        "_to"
      ],
      "additionalProperties": false
    }
  ]
}
