{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/variants_genomic_elements.AFGRCAQtl.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Variant key, genomic element key and the source name AFGR joined by underscores.",
          "example": "NC_000001.11:903006:T:C_accessible_dna_element_1_906596_907043_GRCh38_AFGR"
        },
        "_from": {
          "example": "variants/NC_000001.11:903006:T:C",
          "pattern": "^variants/",
          "collections": [
            "variants"
          ]
        },
        "_to": {
          "example": "genomic_elements/accessible_dna_element_1_906596_907043_GRCh38_AFGR",
          "pattern": "^genomic_elements/",
          "collections": [
            "genomic_elements"
          ]
        },
        "label": {
          "enum": [
            "caQTL"
          ]
        },
        "neg_log10_pvalue": {
          "type": "number",
          "description": "Negative log10 of the nominal association p-value."
        },
        "p_value": {
          "type": "number",
          "description": "Nominal p-value of association between the variant and chromatin accessibility of the peak."
        },
        "beta": {
          "type": "number",
          "description": "Regression coefficient of the alternate allele on chromatin accessibility."
        },
        "source": {
          "enum": [
            "AFGR"
          ]
        },
        "source_url": {
          "enum": [
            "https://github.com/smontgomlab/AFGR"
          ]
        },
        "files_filesets": {
          "type": "string",
          "description": "Handle of the files_filesets record for the IGVF file this QTL was read from."
        },
        "biological_context": {
          "type": "string",
          "description": "Tissue the QTL was measured in. AFGR used lymphoblastoid cell lines.",
          "enum": [
            "lymphoblastoid cell line"
          ]
        },
        "biosample_term": {
          "type": "string",
          "description": "Ontology term for lymphoblastoid cell line, as a handle into ontology_terms.",
          "enum": [
            "ontology_terms/EFO_0005292"
          ]
        },
        "name": {
          "enum": [
            "modulates accessibility of"
          ]
        },
        "inverse_name": {
          "enum": [
            "accessibility modulated by"
          ]
        },
        "method": {
          "enum": [
            "caQTL"
          ]
        },
        "class": {
          "enum": [
            "observed data"
          ]
        }
      },
      "required": [
        "_key",
        "neg_log10_pvalue",
        "p_value",
        "beta",
        "biological_context",
        "biosample_term",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "variants_genomic_elements",
  "accessible_via": {
    "filter_by_range": "neg_log10_pvalue, p_value, beta",
    "return": "neg_log10_pvalue, p_value, beta, source, label, source_url, files_filesets, biological_context, biosample_term, name, inverse_name, method"
  }
}
