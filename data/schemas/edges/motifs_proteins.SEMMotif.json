{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/edges/motifs_proteins.SEMMotif.json",
  "accessible_via": {
    "return": "_id, name, inverse_name, biological_process, source, source_url, class, method, files_filesets"
  },
  "db_collection_name": "motifs_proteins",
  "allOf": [
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "type": "string",
          "description": "Motif key and Ensembl protein ID joined by an underscore."
        },
        "_from": {
          "type": "string",
          "description": "Document handle of the motif, whose key is the transcription factor name followed by _SEMpl.",
          "pattern": "^motifs/",
          "collections": [
            "motifs"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Document handle of the transcription factor protein the motif models binding for.",
          "pattern": "^proteins/",
          "collections": [
            "proteins"
          ]
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "is used by"
          ]
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "uses"
          ]
        },
        "biological_process": {
          "type": "string",
          "description": "Gene Ontology term for the process this edge represents. GO_0003677 is 'DNA binding'.",
          "enum": [
            "ontology_terms/GO_0003677"
          ]
        },
        "source": {
          "$ref": "../mixins.json#/source",
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "$ref": "../mixins.json#/source_url",
          "example": "https://data.igvf.org/model-files/IGVFFI9967LYCS",
          "pattern": "^https://data.igvf.org/model-files/"
        },
        "class": {
          "$ref": "../mixins.json#/class",
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "$ref": "../mixins.json#/method",
          "enum": [
            "SEMpl"
          ]
        }
      },
      "required": [
        "_key",
        "_from",
        "_to",
        "name",
        "inverse_name",
        "biological_process",
        "source",
        "source_url",
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
