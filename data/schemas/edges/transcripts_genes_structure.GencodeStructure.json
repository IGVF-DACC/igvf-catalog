{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "edges/transcripts_genes_structure.GencodeStructure.json",
  "db_collection_name": "transcripts_genes_structure",
  "allOf": [
    {
      "properties": {
        "organism": {
          "$ref": "../mixins.json#/organism/organism"
        },
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_from": {
          "type": "string",
          "description": "Document handle of the transcript that contains the feature.",
          "example": "transcripts/ENST00000456328",
          "pattern": "^transcripts/ENST[0-9]{11}(?:_PAR_Y)?$",
          "collections": [
            "transcripts"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Document handle of the sub-transcript feature.",
          "example": "genes_structure/ENST00000456328_ENSE00002234944_exon",
          "pattern": "^genes_structure/",
          "collections": [
            "genes_structure"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "GENCODE"
          ]
        },
        "version": {
          "type": "string",
          "description": "GENCODE release the annotation was taken from.",
          "enum": [
            "v43"
          ]
        },
        "source_url": {
          "type": "string",
          "enum": [
            "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_43/gencode.v43.chr_patch_hapl_scaff.annotation.gtf.gz"
          ]
        },
        "organism": {
          "enum": [
            "Homo sapiens"
          ]
        },
        "name": {
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "contains"
          ]
        },
        "inverse_name": {
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "contained in"
          ]
        }
      },
      "required": [
        "_from",
        "_to",
        "source",
        "version",
        "source_url",
        "organism",
        "name",
        "inverse_name"
      ],
      "additionalProperties": false
    }
  ]
}
