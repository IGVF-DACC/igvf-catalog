{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "edges/transcripts_genes_structure.GencodeStructure.json",
  "db_collection_name": "transcripts_genes_structure",
  "type": "object",
  "properties": {
    "_from": {
      "type": "string",
      "description": "Document handle of the transcript that contains the feature.",
      "example": "transcripts/ENST00000456328",
      "pattern": "^transcripts/ENST[0-9]{11}(?:_PAR_Y)?$",
      "collections": [
        "transcripts"
      ]
    },
    "_to": {
      "type": "string",
      "description": "Document handle of the sub-transcript feature.",
      "example": "genes_structure/ENST00000456328_ENSE00002234944_exon",
      "pattern": "^genes_structure/",
      "collections": [
        "genes_structure"
      ]
    },
    "source": {
      "type": "string",
      "description": "The dataset this edge was loaded from.",
      "enum": [
        "GENCODE"
      ]
    },
    "version": {
      "type": "string",
      "description": "GENCODE release the annotation was taken from.",
      "enum": [
        "v43"
      ]
    },
    "source_url": {
      "type": "string",
      "description": "Link to the GENCODE annotation file this edge was derived from.",
      "enum": [
        "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_43/gencode.v43.chr_patch_hapl_scaff.annotation.gtf.gz"
      ]
    },
    "organism": {
      "type": "string",
      "description": "Species this annotation describes.",
      "enum": [
        "Homo sapiens"
      ]
    },
    "name": {
      "type": "string",
      "description": "Predicate describing the relationship in the _from to _to direction: the transcript contains this feature.",
      "enum": [
        "contains"
      ]
    },
    "inverse_name": {
      "type": "string",
      "description": "Predicate describing the same relationship in the _to to _from direction: the feature is contained in the transcript.",
      "enum": [
        "contained in"
      ]
    }
  },
  "required": [
    "_from",
    "_to",
    "source",
    "version",
    "source_url",
    "organism",
    "name",
    "inverse_name"
  ],
  "additionalProperties": false
}
