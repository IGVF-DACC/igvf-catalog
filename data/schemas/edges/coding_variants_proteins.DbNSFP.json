{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/coding_variants_proteins.DbNSFP.json",
  "type": "object",
  "properties": {
    "_from": {
      "type": "string",
      "description": "Handle of the coding consequence.",
      "example": "coding_variants/OR4F5_ENST00000641515_p.Met1!_c.1A-C",
      "pattern": "^coding_variants/",
      "collections": [
        "coding_variants"
      ]
    },
    "_to": {
      "type": "string",
      "description": "Handle of the protein. The adapter writes the Ensembl protein ID from dbNSFP; isoform suffixes are stripped if present.",
      "example": "proteins/ENSP00000493376",
      "pattern": "^proteins/",
      "collections": [
        "proteins"
      ]
    },
    "type": {
      "type": "string",
      "description": "Whether the consequence is a protein-coding amino-acid change or a splice-site SNP (aapos = -1).",
      "enum": [
        "protein coding",
        "splicing"
      ]
    },
    "name": {
      "type": "string",
      "description": "Predicate for the coding-variant to protein direction.",
      "enum": [
        "variant of"
      ]
    },
    "inverse_name": {
      "type": "string",
      "description": "Predicate for the protein to coding-variant direction.",
      "enum": [
        "has variant"
      ]
    },
    "source": {
      "type": "string",
      "description": "dbNSFP release this record was read from.",
      "enum": [
        "dbNSFP 5.1a"
      ]
    },
    "source_url": {
      "type": "string",
      "description": "dbNSFP project page.",
      "enum": [
        "http://database.liulab.science/dbNSFP"
      ]
    }
  },
  "required": [
    "_from",
    "_to",
    "type",
    "source",
    "source_url",
    "name",
    "inverse_name"
  ],
  "additionalProperties": false,
  "db_collection_name": "coding_variants_proteins"
}
