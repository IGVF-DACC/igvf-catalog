{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/coding_variants_proteins.DbNSFP.json",
  "db_collection_name": "coding_variants_proteins",
  "allOf": [
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/source_url"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_from": {
          "type": "string",
          "description": "Handle of the coding consequence.",
          "example": "coding_variants/OR4F5_ENST00000641515_p.Met1!_c.1A-C",
          "pattern": "^coding_variants/",
          "collections": [
            "coding_variants"
          ]
        },
        "_to": {
          "type": "string",
          "description": "Handle of the protein. The adapter writes the Ensembl protein ID from dbNSFP; isoform suffixes are stripped if present.",
          "example": "proteins/ENSP00000493376",
          "pattern": "^proteins/",
          "collections": [
            "proteins"
          ]
        },
        "type": {
          "title": "Type",
          "type": "string",
          "description": "Category of the variant consequence.",
          "enum": [
            "protein coding",
            "splicing"
          ],
          "enum_descriptions": {
            "protein coding": "An amino acid change in a protein-coding sequence.",
            "splicing": "A splice-site single-nucleotide variant, represented with amino acid position -1."
          }
        },
        "name": {
          "title": "Name",
          "type": "string",
          "description": "Directional human readable label for the relationship, _from to _to.",
          "enum": [
            "variant of"
          ]
        },
        "inverse_name": {
          "title": "Inverse Name",
          "type": "string",
          "description": "Reversed directional human readable label for the relationship, _to to _from.",
          "enum": [
            "has variant"
          ]
        },
        "source": {
          "enum": [
            "dbNSFP 5.1a"
          ]
        },
        "source_url": {
          "enum": [
            "http://database.liulab.science/dbNSFP"
          ]
        }
      },
      "required": [
        "_from",
        "_to",
        "type",
        "source",
        "source_url",
        "name",
        "inverse_name"
      ],
      "additionalProperties": false
    }
  ]
}
