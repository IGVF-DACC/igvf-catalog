{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/edges/genomic_elements_genes.scE2G.json",
  "allOf": [
    {
      "$ref": "edges.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "biological_context": {
          "$ref": "../mixins.json#/biological_context"
        },
        "biosample_term": {
          "$ref": "../mixins.json#/biosample_term"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "description": "Genomic element key, Ensembl gene ID, biosample term and cell annotation term joined by underscores.",
          "example": "promoter_chr1_169893055_169894554_GRCh38_IGVFFI5648GWQX_ENSG00000000457_CL_0000336_CL_0000336"
        },
        "_from": {
          "example": "genomic_elements/promoter_chr1_169893055_169894554_GRCh38_IGVFFI5648GWQX",
          "pattern": "^genomic_elements/",
          "collections": [
            "genomic_elements"
          ]
        },
        "_to": {
          "example": "genes/ENSG00000000457",
          "pattern": "^genes/",
          "collections": [
            "genes"
          ]
        },
        "method": {
          "enum": [
            "scE2G"
          ]
        },
        "label": {
          "enum": [
            "predicted regulatory element effect on gene expression"
          ]
        },
        "class": {
          "enum": [
            "prediction"
          ]
        },
        "score": {
          "title": "Score",
          "type": "number",
          "description": "scE2G score: Probability that the element has a regulatory effect on the target gene",
          "example": 0.95
        },
        "transcription_start_site": {
          "title": "Transcription Start Site",
          "type": "integer",
          "description": "Transcription start site of the target gene used by the model, as a 0-based coordinate."
        },
        "rna_pseudobulk_tpm": {
          "title": "RNA Pseudobulk TPM",
          "type": [
            "number",
            "null"
          ],
          "description": "RNA pseudobulk TPM of the target gene in the cell type"
        },
        "biological_context": {
          "type": [
            "string",
            "null"
          ],
          "example": "adrenal medulla chromaffin cell"
        },
        "biosample_term": {
          "type": [
            "string",
            "null"
          ],
          "example": "ontology_terms/CL_0000336"
        },
        "cell_annotation": {
          "title": "Cell Annotation",
          "type": [
            "string",
            "null"
          ],
          "description": "The cell annotation of the file set, with optional qualifier, for single-cell derived results.",
          "example": "pluripotent epiblast cell derived from mouse embryonic stem cell"
        },
        "cell_annotation_term": {
          "title": "Cell Annotation Term",
          "type": [
            "string",
            "null"
          ],
          "description": "Base ontology term describing the cell type of a single-cell derived result.",
          "example": "ontology_terms/CL_0000352",
          "pattern": "^ontology_terms/[A-Z0-9_]+$"
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI5648GWQX",
          "pattern": "^https://data\\.igvf\\.org/tabular-files/"
        },
        "name": {
          "enum": [
            "regulates"
          ]
        },
        "inverse_name": {
          "enum": [
            "regulated by"
          ]
        }
      },
      "required": [
        "score",
        "transcription_start_site",
        "rna_pseudobulk_tpm",
        "biological_context",
        "biosample_term",
        "cell_annotation",
        "cell_annotation_term",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "filter_by_range": "score",
    "return": "class, label, method, source, source_url, files_filesets, biological_context, biosample_term, cell_annotation, cell_annotation_term, score, transcription_start_site, rna_pseudobulk_tpm"
  },
  "db_collection_name": "genomic_elements_genes"
}
