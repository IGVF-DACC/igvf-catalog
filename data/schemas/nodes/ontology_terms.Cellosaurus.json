{
  "$id": "schemas/nodes/ontology_terms.Cellosaurus.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "CVCL_JJ44"
        },
        "uri": {
          "type": "string",
          "description": "The URI of the ontology term",
          "example": "https://www.cellosaurus.org/CVCL_JJ44"
        },
        "term_id": {
          "type": "string",
          "description": "The ID of the ontology term",
          "example": "CVCL_JJ44"
        },
        "name": {
          "example": "CW70177"
        },
        "synonyms": {
          "type": [
            "array",
            "null"
          ],
          "description": "The synonyms of the ontology term",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "enum": [
            "Cellosaurus"
          ]
        },
        "source_url": {
          "enum": [
            "https://www.cellosaurus.org/"
          ]
        },
        "subset": {
          "type": [
            "array",
            "null"
          ],
          "description": "The subset of the ontology term",
          "example": [
            "Induced_pluripotent_stem_cell",
            "Female"
          ],
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": "string",
          "description": "The class of the ontology term, from the associated files_filesets record"
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "description": "The method of the ontology term, from the associated files_filesets record"
        },
        "files_filesets": {
          "type": "string",
          "description": "The files filesets of the ontology term",
          "example": "files_filesets/IGVFFI9279GNOP",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "uri",
        "term_id",
        "synonyms",
        "subset",
        "class",
        "method",
        "files_filesets"
      ]
    }
  ],
  "additionalProperties": false,
  "db_collection_name": "ontology_terms"
}
