{
  "$id": "schemas/nodes/ontology_terms.Cellosaurus.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "CVCL_JJ44",
          "description": "Cellosaurus accession of the cell line."
        },
        "uri": {
          "type": "string",
          "description": "URI for the ontology term.",
          "example": "https://www.cellosaurus.org/CVCL_JJ44"
        },
        "term_id": {
          "type": "string",
          "description": "Ontology term identifier.",
          "example": "CVCL_JJ44"
        },
        "name": {
          "example": "CW70177",
          "description": "Human readable display name for the entity"
        },
        "synonyms": {
          "type": [
            "array",
            "null"
          ],
          "description": "Alternative names for the ontology term.",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "description": "The database, dataset or organization that is a source for these data.",
          "enum": [
            "Cellosaurus"
          ]
        },
        "source_url": {
          "description": "The URL for the source.",
          "enum": [
            "https://www.cellosaurus.org/"
          ]
        },
        "subset": {
          "type": [
            "array",
            "null"
          ],
          "description": "Cellosaurus category tags for the cell line, including cell-line class and sex of the donor. Null when the OBO entry has none.",
          "example": [
            "Induced_pluripotent_stem_cell",
            "Female"
          ],
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": "string",
          "description": "The class of the data this record belongs to: 'observed data' for a direct experimental measurement, 'prediction' for the output of a computational model, and 'biological relationship' for a curated relationship."
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "description": "Name of the experimental class or prediction model that produced this result."
        },
        "files_filesets": {
          "type": "string",
          "description": "Reference to the File and Metadata",
          "example": "files_filesets/IGVFFI9279GNOP",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "uri",
        "term_id",
        "synonyms",
        "subset",
        "class",
        "method",
        "files_filesets"
      ]
    }
  ],
  "additionalProperties": false,
  "db_collection_name": "ontology_terms"
}
