{
  "$id": "schemas/nodes/ontology_terms.Cellosaurus.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "CVCL_JJ44",
          "description": "Cellosaurus accession of the cell line."
        },
        "uri": {
          "type": "string",
          "description": "Cellosaurus page for this cell line.",
          "example": "https://www.cellosaurus.org/CVCL_JJ44"
        },
        "term_id": {
          "type": "string",
          "description": "Cellosaurus accession of the cell line.",
          "example": "CVCL_JJ44"
        },
        "name": {
          "example": "CW70177",
          "description": "Recommended name of the cell line."
        },
        "synonyms": {
          "type": [
            "array",
            "null"
          ],
          "description": "Alternative names for the cell line. Null when the OBO entry has none.",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "enum": [
            "Cellosaurus"
          ]
        },
        "source_url": {
          "enum": [
            "https://www.cellosaurus.org/"
          ]
        },
        "subset": {
          "type": [
            "array",
            "null"
          ],
          "description": "Cellosaurus category tags for the cell line, including cell-line class and sex of the donor. Null when the OBO entry has none.",
          "example": [
            "Induced_pluripotent_stem_cell",
            "Female"
          ],
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": "string",
          "description": "The class of the ontology term, from the associated files_filesets record"
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "description": "The method of the ontology term, from the associated files_filesets record"
        },
        "files_filesets": {
          "type": "string",
          "description": "Handle of the files_filesets record for the Cellosaurus OBO file this term was read from.",
          "example": "files_filesets/IGVFFI9279GNOP",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "uri",
        "term_id",
        "synonyms",
        "subset",
        "class",
        "method",
        "files_filesets"
      ]
    }
  ],
  "additionalProperties": false,
  "db_collection_name": "ontology_terms"
}
