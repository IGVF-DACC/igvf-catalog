{
  "$id": "schemas/nodes/ontology_terms.Cellosaurus.json",
  "allOf": [
    {
      "$ref": "ontology_terms.base.json"
    },
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "CVCL_JJ44",
          "description": "Cellosaurus accession of the cell line."
        },
        "uri": {
          "example": "https://www.cellosaurus.org/CVCL_JJ44"
        },
        "term_id": {
          "example": "CVCL_JJ44"
        },
        "name": {
          "example": "CW70177",
          "description": "Human readable display name for the entity"
        },
        "synonyms": {
          "type": [
            "array",
            "null"
          ],
          "description": "Alternative names for the ontology term.",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "enum": [
            "Cellosaurus"
          ]
        },
        "source_url": {
          "enum": [
            "https://www.cellosaurus.org/"
          ]
        },
        "subset": {
          "type": [
            "array",
            "null"
          ],
          "description": "Cellosaurus category tags for the cell line, including cell-line class and sex of the donor. Null when the OBO entry has none.",
          "example": [
            "Induced_pluripotent_stem_cell",
            "Female"
          ],
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": "string"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI9279GNOP",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "synonyms",
        "subset",
        "class",
        "method",
        "files_filesets"
      ]
    }
  ],
  "additionalProperties": false,
  "db_collection_name": "ontology_terms"
}
