{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/genomic_elements.CAQtl.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "accessible_dna_element_chr1_778381_779150_GRCh38_ENCFF103XRK"
        },
        "name": {
          "description": "Human readable display name for the entity",
          "example": "accessible_dna_element_chr1_778381_779150_GRCh38_ENCFF103XRK"
        },
        "method": {
          "description": "Name of the experimental class or prediction model that produced this result.",
          "enum": [
            "caQTL"
          ]
        },
        "source": {
          "description": "The database, dataset or organization that is a source for these data.",
          "enum": [
            "ENCODE"
          ]
        },
        "source_url": {
          "description": "The URL for the source.",
          "example": "https://www.encodeproject.org/files/ENCFF103XRK/",
          "pattern": "^https://www.encodeproject.org/files/"
        },
        "type": {
          "enum": [
            "accessible dna elements"
          ]
        },
        "files_filesets": {
          "type": "string",
          "description": "Reference to the File and Metadata",
          "example": "files_filesets/ENCFF103XRK",
          "pattern": "^files_filesets/"
        }
      },
      "required": [
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements"
}
