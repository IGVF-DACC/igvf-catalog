{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/genomic_elements.CCRE.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "candidate_cis_regulatory_element_chr1_16097_16381_GRCh38_ENCFF420VPZ"
        },
        "name": {
          "example": "EH38E3951272",
          "description": "Human readable display name for the entity"
        },
        "source_annotation": {
          "type": "string",
          "description": "Cell-type-agnostic SCREEN class of the cCRE, as the short code followed by its SCREEN label. Assigned from chromatin accessibility, H3K4me3, H3K27ac, CTCF, and transcription-factor binding, plus distance to the nearest TSS.",
          "enum": [
            "CA-CTCF: chromatin accessible + CTCF binding",
            "CA-TF: chromatin accessible + TF binding",
            "CA-H3K4me3: chromatin accessible + H3K4me3 high signal",
            "PLS: Promoter-like signal",
            "pELS: proximal Enhancer-like signal",
            "dELS: distal Enhancer-like signal",
            "TF: TF binding",
            "CA: chromatin accessible"
          ]
        },
        "method": {
          "enum": [
            "candidate Cis-Regulatory Elements"
          ]
        },
        "type": {
          "enum": [
            "candidate cis regulatory element"
          ]
        },
        "source": {
          "enum": [
            "ENCODE"
          ]
        },
        "source_url": {
          "enum": [
            "https://www.encodeproject.org/files/ENCFF420VPZ"
          ]
        },
        "files_filesets": {
          "enum": [
            "files_filesets/ENCFF420VPZ"
          ]
        }
      },
      "required": [
        "source_annotation",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "filter_by_range": "start, end",
    "return": "_id, name, chr, start, end, type, source_annotation, type, source, source_url"
  },
  "db_collection_name": "genomic_elements"
}
