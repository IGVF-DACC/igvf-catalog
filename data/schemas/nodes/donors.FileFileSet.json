{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/donors.FileFileSet.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "ENCDO374BBL"
        },
        "name": {
          "description": "Human readable display name for the entity",
          "example": "ENCDO374BBL"
        },
        "sex": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sex of the donor: female, male, mixed, unknown, or unspecified.",
          "enum": [
            "female",
            "male",
            "mixed",
            "unknown",
            "unspecified"
          ]
        },
        "age": {
          "type": [
            "string",
            "null"
          ],
          "description": "Age of the donor, in the units given by age_units. Stored as a string, since the portal records open-ended values as well as exact ages.",
          "example": "35"
        },
        "age_units": {
          "type": [
            "string",
            "null"
          ],
          "description": "Unit the age value is expressed in: day, week, month, or year.",
          "enum": [
            "day",
            "month",
            "week",
            "year",
            null
          ]
        },
        "ethnicities": {
          "type": [
            "array",
            "null"
          ],
          "description": "Ethnicity of the donor.",
          "example": [
            "African American"
          ]
        },
        "phenotypic_features": {
          "type": [
            "array",
            "null"
          ],
          "description": "Phenotypic features observed for the donor, with DOID identifiers mapped onto MONDO or HP.",
          "example": [
            "ontology_terms/DOID_3308"
          ]
        },
        "source": {
          "enum": [
            "ENCODE",
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://www.encodeproject.org/human-donors/ENCDO374BBL/"
        }
      },
      "required": [
        "sex",
        "age",
        "age_units",
        "ethnicities",
        "phenotypic_features"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "donors"
}
