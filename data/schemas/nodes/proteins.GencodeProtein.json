{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/proteins.GencodeProtein.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "properties": {
        "organism": {
          "$ref": "../mixins.json#/organism"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "ENSP00000493376 or ENSMUSP00000077785",
          "pattern": "^(ENSP|ENSMUSP)[0-9]{11}$"
        },
        "MANE_Select": {
          "type": "boolean",
          "description": "Whether GENCODE tags the transcript this protein is translated from as MANE Select: the single transcript per protein-coding gene that Ensembl and RefSeq agree on as the representative isoform.",
          "example": true
        },
        "protein_id": {
          "type": "string",
          "description": "Ensembl ID of the protein (without version number).",
          "example": "ENSP00000493376.2 or ENSMUSP00000077785.1",
          "pattern": "^(ENSP|ENSMUSP)[0-9]{11}\\.[0-9]+$"
        },
        "source": {
          "enum": [
            "GENCODE"
          ]
        },
        "version": {
          "type": "string",
          "description": "GENCODE release the annotation was taken from.",
          "enum": [
            "v43",
            "vM36"
          ]
        },
        "source_url": {
          "enum": [
            "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_43/gencode.v43.chr_patch_hapl_scaff.annotation.gtf.gz",
            "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M36/gencode.vM36.chr_patch_hapl_scaff.annotation.gtf.gz"
          ]
        },
        "organism": {
          "enum": [
            "Homo sapiens",
            "Mus musculus"
          ]
        },
        "uniprot_collection": {
          "type": "string",
          "description": "Which section of UniProtKB the mapped entries come from: Swiss-Prot for manually reviewed entries, TrEMBL for automatically annotated ones.",
          "enum": [
            "Swiss-Prot",
            "TrEMBL"
          ]
        },
        "uniprot_ids": {
          "type": "array",
          "description": "UniProtKB accessions mapped to this Ensembl protein (isoforms specific).",
          "items": {
            "type": "string"
          },
          "example": [
            "Q6UWL6-5"
          ]
        },
        "uniprot_names": {
          "type": "array",
          "description": "UniProtKB entry names of the mapped accessions.",
          "items": {
            "type": "string"
          },
          "example": [
            "CDK2_HUMAN"
          ]
        },
        "dbxrefs": {
          "type": "array",
          "description": "Cross-references to other databases, taken from the mapped UniProtKB entries.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Database the cross-reference points to.",
                "example": "Ensembl"
              },
              "id": {
                "type": "string",
                "description": "Identifier of this protein in that database.",
                "example": "ENST00000641515.2"
              }
            }
          }
        },
        "uniprot_full_names": {
          "type": "array",
          "description": "Recommended full protein names from the mapped UniProtKB entries",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "organism",
        "protein_id",
        "version",
        "MANE_Select"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "simplified_return": "_id, name, uniprot_names",
    "return": "_id, name, uniprot_names, uniprot_full_names, uniprot_ids, MANE_Select, organism, source, source_url, dbxrefs"
  },
  "db_collection_name": "proteins"
}
