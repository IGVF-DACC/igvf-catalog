{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/genomic_elements.CRISPRElementGeneIGVF.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        }
      }
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "CRISPR_chr1_212699339_212700840_GRCh38_IGVFFI3069QCRA"
        },
        "name": {
          "description": "Human readable display name for the entity",
          "example": "CRISPR_chr1_212699339_212700840_GRCh38_IGVFFI3069QCRA"
        },
        "promoter_of": {
          "type": "string",
          "description": "The gene this element is the presumed promoter of.",
          "example": "genes/ENSG00000123685"
        },
        "method": {
          "enum": [
            "Perturb-seq",
            "CRISPR screen"
          ]
        },
        "source_annotation": {
          "type": "string",
          "description": "Annotation of the element, usually enhancer, promoter, distal or accessible element.",
          "example": "promoter",
          "enum": [
            "enhancer",
            "promoter",
            "distal element"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://api.data.igvf.org/tabular-files/IGVFFI3069QCRA/"
        },
        "type": {
          "enum": [
            "tested elements"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI3069QCRA",
          "pattern": "^files_filesets/"
        }
      },
      "required": [
        "source_annotation",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements"
}
