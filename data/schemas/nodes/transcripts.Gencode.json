{
  "$id": "schemas/nodes/transcripts.Gencode.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "pattern": "^ENST[0-9]{11}(?:_PAR_Y)?$",
          "example": "ENST00000456328"
        },
        "transcript_id": {
          "type": "string",
          "description": "Ensembl transcript ID including its version suffix. The _key of this record is the same ID with the version removed.",
          "example": "ENST00000456328.2",
          "pattern": "^ENST[0-9]{11}\\.[0-9]+(?:_PAR_Y)?$"
        },
        "name": {
          "example": "DDX11L2-202"
        },
        "transcript_type": {
          "type": "string",
          "description": "Biotype GENCODE assigns to the transcript.",
          "enum": [
            "artifact",
            "IG_C_gene",
            "IG_C_pseudogene",
            "IG_D_gene",
            "IG_J_gene",
            "IG_J_pseudogene",
            "IG_pseudogene",
            "IG_V_gene",
            "IG_V_pseudogene",
            "lncRNA",
            "miRNA",
            "misc_RNA",
            "Mt_rRNA",
            "Mt_tRNA",
            "non_stop_decay",
            "nonsense_mediated_decay",
            "processed_pseudogene",
            "processed_transcript",
            "protein_coding",
            "protein_coding_CDS_not_defined",
            "protein_coding_LoF",
            "pseudogene",
            "retained_intron",
            "ribozyme",
            "rRNA",
            "rRNA_pseudogene",
            "scaRNA",
            "scRNA",
            "snoRNA",
            "snRNA",
            "sRNA",
            "TEC",
            "TR_C_gene",
            "TR_D_gene",
            "TR_J_gene",
            "TR_J_pseudogene",
            "TR_V_gene",
            "TR_V_pseudogene",
            "transcribed_processed_pseudogene",
            "transcribed_unitary_pseudogene",
            "transcribed_unprocessed_pseudogene",
            "translated_processed_pseudogene",
            "translated_unprocessed_pseudogene",
            "unitary_pseudogene",
            "unprocessed_pseudogene",
            "vault_RNA"
          ],
          "example": "lncRNA"
        },
        "chr": {
          "type": "string",
          "description": "Chromosome the transcript lies on, prefixed with 'chr'. Scaffolds and patch regions use UCSC-style names.",
          "example": "chr9",
          "pattern": "^chr"
        },
        "start": {
          "type": "number",
          "description": "Start of the transcript, 0-based and inclusive.",
          "example": 11869
        },
        "end": {
          "type": "number",
          "description": "End of the transcript, 0-based and exclusive.",
          "example": 14409
        },
        "strand": {
          "type": "string",
          "description": "Strand the transcript is transcribed from: '+' for the forward strand, '-' for the reverse strand.",
          "enum": [
            "+",
            "-"
          ]
        },
        "gene_name": {
          "type": "string",
          "description": "GENCODE symbol of the gene this transcript belongs to.",
          "example": "DDX11L2"
        },
        "MANE_Select": {
          "type": "boolean",
          "description": "Whether GENCODE tags this transcript as MANE Select: the single transcript per protein-coding gene that Ensembl and RefSeq agree on as the representative isoform.",
          "example": true
        },
        "source": {
          "enum": [
            "GENCODE"
          ]
        },
        "version": {
          "type": "string",
          "description": "GENCODE release the annotation was taken from.",
          "enum": [
            "v43"
          ]
        },
        "source_url": {
          "enum": [
            "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_43/gencode.v43.chr_patch_hapl_scaff.annotation.gtf.gz"
          ]
        },
        "organism": {
          "type": "string",
          "description": "Species this annotation describes.",
          "enum": [
            "Homo sapiens"
          ]
        }
      },
      "required": [
        "transcript_id",
        "transcript_type",
        "chr",
        "start",
        "end",
        "strand",
        "gene_name",
        "MANE_Select",
        "version",
        "organism"
      ]
    }
  ],
  "additionalProperties": false,
  "accessible_via": {
    "filter_by_range": "start, end",
    "return": "_id, chr, start, end, strand, gene_name, transcript_id, name, transcript_type, MANE_Select, source, version, source_url, organism"
  },
  "db_collection_name": "transcripts"
}
