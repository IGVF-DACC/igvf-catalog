{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/drugs.PharmGKB.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "PA166238901",
          "description": "PharmGKB chemical accession."
        },
        "name": {
          "example": "17-alpha-dihydroequilenin sulfate"
        },
        "drug_ontology_terms": {
          "title": "Drug Ontology Terms",
          "type": "array",
          "description": "ChEBI ontology terms for this drug.",
          "example": [
            "ontology_terms/CHEBI_15956"
          ],
          "items": {
            "type": "string",
            "pattern": "^ontology_terms/[A-Z0-9_]+$"
          }
        },
        "source": {
          "enum": [
            "pharmGKB"
          ]
        },
        "source_url": {
          "pattern": "^https://www\\.pharmgkb\\.org/chemical/[A-Z0-9]+$",
          "example": "https://www.pharmgkb.org/chemical/PA166238901"
        },
        "class": {
          "$ref": "../mixins.json#/class",
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "$ref": "../mixins.json#/method",
          "enum": [
            "PharmGKB"
          ]
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      },
      "required": [
        "drug_ontology_terms",
        "class",
        "method",
        "files_filesets"
      ]
    }
  ],
  "additionalProperties": false,
  "accessible_via": {
    "return": "_id, name, drug_ontology_terms, source, source_url, class, method, files_filesets"
  },
  "db_collection_name": "drugs",
  "threshold": "No separate statistical significance call is assigned to these entity records. Source association filters and significance criteria are documented in variants_drugs_genes.PharmGKB.json, variants_drugs.PharmGKB.json; presence of an entity does not imply a significant association."
}
