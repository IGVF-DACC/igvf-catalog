{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/drugs.PharmGKB.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "PA166238901"
        },
        "name": {
          "example": "17-alpha-dihydroequilenin sulfate"
        },
        "drug_ontology_terms": {
          "type": "array",
          "description": "The drug ontology terms of the drug",
          "example": [
            "ontology_terms/CHEBI_15956"
          ],
          "items": {
            "type": "string",
            "pattern": "^ontology_terms/[A-Z0-9_]+$"
          }
        },
        "source": {
          "enum": [
            "pharmGKB"
          ]
        },
        "source_url": {
          "pattern": "^https://www\\.pharmgkb\\.org/chemical/[A-Z0-9]+$",
          "example": "https://www.pharmgkb.org/chemical/PA166238901"
        },
        "class": {
          "type": "string",
          "description": "The class of the drug, from the associated files_filesets record",
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "type": "string",
          "description": "The method of the drug, from the associated files_filesets record",
          "enum": [
            "PharmGKB"
          ]
        },
        "files_filesets": {
          "type": "string",
          "description": "The files filesets of the drug",
          "example": "files_filesets/IGVFFI2997DUKO",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "drug_ontology_terms",
        "class",
        "method",
        "files_filesets"
      ]
    }
  ],
  "additionalProperties": false,
  "accessible_via": {
    "return": "_id, name, drug_ontology_terms, source, source_url, class, method, files_filesets"
  },
  "db_collection_name": "drugs"
}
