{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/ontology_terms.Oncotree.json",
  "db_collection_name": "ontology_terms",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "Oncotree_0_0"
        },
        "name": {
          "example": "0_0"
        },
        "uri": {
          "type": "string",
          "description": "The URI of the ontology term",
          "example": "https://oncotree.mskcc.org/api/tumorTypes/0_0"
        },
        "term_id": {
          "type": "string",
          "description": "The ID of the ontology term",
          "example": "0_0"
        },
        "source": {
          "enum": [
            "Oncotree"
          ]
        },
        "source_url": {
          "enum": [
            "https://oncotree.mskcc.org/api/tumorTypes"
          ]
        },
        "class": {
          "type": "string",
          "description": "The class of the ontology term",
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "description": "The method of the ontology term, from the associated files_filesets record"
        },
        "files_filesets": {
          "type": "string",
          "description": "The files filesets of the ontology term",
          "example": "files_filesets/IGVFFI0000ONCO",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "uri",
        "term_id",
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
