{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/ontology_terms.Oncotree.json",
  "db_collection_name": "ontology_terms",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "Oncotree_MMB",
          "description": "Oncotree_ plus the OncoTree code, with slash rewritten to underscore."
        },
        "name": {
          "example": "Medullomyoblastoma",
          "description": "Tumor-type name from the OncoTree API."
        },
        "uri": {
          "type": "string",
          "description": "OncoTree site homepage. The API does not publish a per-node IRI, so every term carries this value.",
          "example": "https://oncotree.mskcc.org/"
        },
        "term_id": {
          "type": "string",
          "description": "Oncotree_ plus the OncoTree code as published (slash left in place).",
          "example": "Oncotree_MMB"
        },
        "source": {
          "enum": [
            "Oncotree"
          ]
        },
        "source_url": {
          "enum": [
            "https://oncotree.mskcc.org/api/tumorTypes"
          ]
        },
        "class": {
          "type": "string",
          "description": "The class of the ontology term",
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "description": "The method of the ontology term, from the associated files_filesets record"
        },
        "files_filesets": {
          "type": "string",
          "description": "Handle of the files_filesets record for the OncoTree tumor-type dump this term was read from.",
          "example": "files_filesets/IGVFFI4975UFZM",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "uri",
        "term_id",
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
