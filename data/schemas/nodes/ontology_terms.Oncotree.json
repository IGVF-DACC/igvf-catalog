{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/ontology_terms.Oncotree.json",
  "db_collection_name": "ontology_terms",
  "allOf": [
    {
      "$ref": "ontology_terms.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "Oncotree_MMB",
          "description": "Oncotree_ plus the OncoTree code, with slash rewritten to underscore."
        },
        "name": {
          "example": "Medullomyoblastoma"
        },
        "uri": {
          "example": "https://oncotree.mskcc.org/"
        },
        "term_id": {
          "example": "Oncotree_MMB"
        },
        "source": {
          "enum": [
            "Oncotree"
          ]
        },
        "source_url": {
          "enum": [
            "https://oncotree.mskcc.org/api/tumorTypes"
          ]
        },
        "class": {
          "$ref": "../mixins.json#/class",
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "$ref": "../mixins.json#/method",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
