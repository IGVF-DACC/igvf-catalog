{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/ontology_terms.Oncotree.json",
  "db_collection_name": "ontology_terms",
  "allOf": [
    {
      "$ref": "ontology_terms.base.json"
    },
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        }
      }
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "Oncotree_MMB",
          "description": "Oncotree_ plus the OncoTree code, with slash rewritten to underscore."
        },
        "name": {
          "example": "Medullomyoblastoma",
          "description": "Human readable display name for the entity"
        },
        "uri": {
          "example": "https://oncotree.mskcc.org/"
        },
        "term_id": {
          "example": "Oncotree_MMB"
        },
        "source": {
          "enum": [
            "Oncotree"
          ]
        },
        "source_url": {
          "enum": [
            "https://oncotree.mskcc.org/api/tumorTypes"
          ]
        },
        "class": {
          "type": "string",
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI4975UFZM",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ]
}
