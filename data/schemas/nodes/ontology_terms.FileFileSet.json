{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/ontology_terms.FileFileSet.json",
  "db_collection_name": "ontology_terms",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "NTR_0000856"
        },
        "name": {
          "example": "mesendoderm"
        },
        "uri": {
          "type": "string",
          "description": "Link to the term's page on the source portal.",
          "example": "https://www.encodeproject.org/biosample-types/in_vitro_differentiated_cells_NTR_0000856/"
        },
        "term_id": {
          "type": "string",
          "description": "Ontology identifier describing the biological sample, with the prefix separated by an underscore rather than a colon. Only NTR terms are loaded here: biosample types the portals describe with a new-term request because no existing ontology term covers them.",
          "example": "NTR_0000856"
        },
        "synonyms": {
          "type": [
            "array",
            "null"
          ],
          "description": "Synonyms for the term that have been recorded in an ontology."
        },
        "source": {
          "enum": [
            "IGVF",
            "ENCODE"
          ]
        },
        "source_url": {
          "example": "https://www.encodeproject.org/biosample-types/in_vitro_differentiated_cells_NTR_0000856/"
        }
      },
      "required": [
        "uri",
        "term_id",
        "synonyms"
      ],
      "additionalProperties": false
    }
  ]
}
