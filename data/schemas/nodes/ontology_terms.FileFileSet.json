{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/ontology_terms.FileFileSet.json",
  "db_collection_name": "ontology_terms",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "NTR_0000856"
        },
        "name": {
          "description": "Human readable display name for the entity",
          "example": "mesendoderm"
        },
        "uri": {
          "type": "string",
          "description": "URI for the ontology term.",
          "example": "https://www.encodeproject.org/biosample-types/in_vitro_differentiated_cells_NTR_0000856/"
        },
        "term_id": {
          "type": "string",
          "description": "Ontology term identifier.",
          "example": "NTR_0000856"
        },
        "synonyms": {
          "type": [
            "array",
            "null"
          ],
          "description": "Alternative names for the ontology term."
        },
        "source": {
          "description": "The database, dataset or organization that is a source for these data.",
          "enum": [
            "IGVF",
            "ENCODE"
          ]
        },
        "source_url": {
          "description": "The URL for the source.",
          "example": "https://www.encodeproject.org/biosample-types/in_vitro_differentiated_cells_NTR_0000856/"
        }
      },
      "required": [
        "uri",
        "term_id",
        "synonyms"
      ],
      "additionalProperties": false
    }
  ]
}
