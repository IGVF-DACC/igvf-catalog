{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/ontology_terms.FileFileSet.json",
  "db_collection_name": "ontology_terms",
  "allOf": [
    {
      "$ref": "ontology_terms.base.json"
    },
    {
      "$ref": "../mixins.json#/provenance"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "NTR_0000856"
        },
        "name": {
          "example": "mesendoderm"
        },
        "uri": {
          "example": "https://www.encodeproject.org/biosample-types/in_vitro_differentiated_cells_NTR_0000856/"
        },
        "term_id": {
          "example": "NTR_0000856"
        },
        "synonyms": {
          "type": [
            "array",
            "null"
          ],
          "description": "Alternative names for the ontology term."
        },
        "source": {
          "enum": [
            "IGVF",
            "ENCODE"
          ]
        },
        "source_url": {
          "example": "https://www.encodeproject.org/biosample-types/in_vitro_differentiated_cells_NTR_0000856/"
        }
      },
      "required": [
        "synonyms"
      ],
      "additionalProperties": false
    }
  ]
}
