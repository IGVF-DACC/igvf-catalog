{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/coding_variants.ESM1vCodingVariantsScores.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "DSG2_ENST00000261590_p.Gln873Thr_c.2617_2618delinsAC"
        },
        "name": {
          "example": "DSG2_ENST00000261590_p.Gln873Thr_c.2617_2618delinsAC"
        },
        "ref": {
          "type": "string",
          "description": "Reference amino acid, in single letter code.",
          "example": "Q"
        },
        "alt": {
          "type": "string",
          "description": "Alternate amino acid, in single letter code.",
          "example": "T"
        },
        "aapos": {
          "type": "integer",
          "description": "1-based position of the substituted residue within the protein."
        },
        "refcodon": {
          "type": "string",
          "description": "Reference codon at the substituted position.",
          "example": "ATG"
        },
        "gene_name": {
          "type": "string",
          "description": "HGNC gene symbol",
          "example": "DSG2"
        },
        "protein_name": {
          "type": "string",
          "description": "UniProtKB protein name.",
          "example": "A0A2U3U0J3_HUMAN"
        },
        "protein_id": {
          "type": "string",
          "description": "Ensembl ID of the protein (without version number).",
          "example": "ENSP00000493376"
        },
        "codonpos": {
          "type": "integer",
          "description": "Position of the variant within the codon: 1, 2 or 3. "
        },
        "hgvsc": {
          "type": "string",
          "description": "HGVS description of the variant in the cDNA reference frame.",
          "example": "c.2617_2618delinsAC"
        },
        "hgvsp": {
          "type": "string",
          "description": "HGVS protein-level description of the variant.",
          "example": "p.Gln873Thr",
          "pattern": "^p."
        },
        "transcript_id": {
          "type": "string",
          "description": "ENSEMBL transcript ID, without version number.",
          "example": "ENST00000261590"
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI8105TNNO",
          "pattern": "^https://data.igvf.org/tabular-files/"
        }
      },
      "required": [
        "ref",
        "alt",
        "aapos",
        "refcodon",
        "gene_name",
        "protein_name",
        "protein_id",
        "codonpos",
        "hgvsc",
        "hgvsp",
        "transcript_id"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "coding_variants"
}
