{
  "$id": "schemas/nodes/ontology_terms.Ontology.json",
  "allOf": [
    {
      "$ref": "ontology_terms.base.json"
    },
    {
      "properties": {
        "method": {
          "$ref": "../mixins.json#/method"
        },
        "class": {
          "$ref": "../mixins.json#/class"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "GO_0000001",
          "description": "Last path segment of the term IRI, with characters ArangoDB disallows in keys rewritten to underscore."
        },
        "uri": {
          "example": "http://purl.obolibrary.org/obo/GO_0000001"
        },
        "term_id": {
          "example": "GO_0000001"
        },
        "name": {
          "example": "mitochondrion inheritance"
        },
        "description": {
          "title": "Description",
          "type": "string",
          "description": "Textual definition of the term (IAO_0000115)."
        },
        "synonyms": {
          "title": "Synonyms",
          "type": "array",
          "description": "Alternative names for the ontology term.",
          "example": [
            "mitochondrial inheritance"
          ],
          "items": {
            "type": "string"
          }
        },
        "source": {
          "enum": [
            "BAO",
            "CHEBI",
            "CL",
            "CLO",
            "DOID",
            "EFO",
            "ENCODE",
            "GO",
            "HPO",
            "MONDO",
            "NCIT",
            "OBA",
            "OBI",
            "Oncotree",
            "ORPHANET",
            "PCL",
            "UBERON",
            "VARIO"
          ]
        },
        "source_url": {
          "example": "https://geneontology.org/"
        },
        "subontology": {
          "title": "Subontology",
          "type": [
            "string",
            "null"
          ],
          "description": "Gene Ontology namespace of the term.",
          "enum": [
            "biological_process",
            "cellular_component",
            "molecular_function",
            null
          ],
          "enum_descriptions": {
            "biological_process": "A biological objective accomplished by molecular activities.",
            "cellular_component": "A cellular location or complex in which a gene product acts.",
            "molecular_function": "A molecular activity performed by a gene product.",
            "null": "The term is not assigned to a Gene Ontology namespace."
          }
        },
        "class": {
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null
          ]
        }
      },
      "required": [
        "description",
        "synonyms",
        "subontology",
        "class",
        "method",
        "files_filesets"
      ]
    }
  ],
  "additionalProperties": false,
  "accessible_via": {
    "return": "_id, uri, term_id, name, synonyms, description, source, subontology, source_url, class, method, files_filesets"
  },
  "db_collection_name": "ontology_terms"
}
