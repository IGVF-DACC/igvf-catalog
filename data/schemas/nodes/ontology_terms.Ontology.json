{
  "$id": "schemas/nodes/ontology_terms.Ontology.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "GO_0000001",
          "description": "Last path segment of the term IRI, with characters ArangoDB disallows in keys rewritten to underscore."
        },
        "uri": {
          "type": "string",
          "description": "URI for the ontology term.",
          "example": "http://purl.obolibrary.org/obo/GO_0000001"
        },
        "term_id": {
          "type": "string",
          "description": "Ontology term identifier.",
          "example": "GO_0000001"
        },
        "name": {
          "example": "mitochondrion inheritance",
          "description": "Human readable display name for the entity"
        },
        "description": {
          "type": "string",
          "description": "Textual definition of the term (IAO_0000115)."
        },
        "synonyms": {
          "type": "array",
          "description": "Alternative names for the ontology term.",
          "example": [
            "mitochondrial inheritance"
          ],
          "items": {
            "type": "string"
          }
        },
        "source": {
          "description": "The database, dataset or organization that is a source for these data.",
          "enum": [
            "BAO",
            "CHEBI",
            "CL",
            "CLO",
            "DOID",
            "EFO",
            "ENCODE",
            "GO",
            "HPO",
            "MONDO",
            "NCIT",
            "OBA",
            "OBI",
            "Oncotree",
            "ORPHANET",
            "PCL",
            "UBERON",
            "VARIO"
          ]
        },
        "source_url": {
          "example": "https://geneontology.org/",
          "description": "The URL for the source."
        },
        "subontology": {
          "type": [
            "string",
            "null"
          ],
          "description": "GO namespace of the term. Null for terms that are not from GO.",
          "enum": [
            "biological_process",
            "cellular_component",
            "molecular_function",
            null
          ]
        },
        "class": {
          "type": "string",
          "description": "The class of the data this record belongs to: 'observed data' for a direct experimental measurement, 'prediction' for the output of a computational model, and 'biological relationship' for a curated relationship.",
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "description": "Name of the experimental class or prediction model that produced this result.",
          "enum": [
            null
          ]
        },
        "files_filesets": {
          "type": "string",
          "description": "Reference to the File and Metadata",
          "example": "files_filesets/IGVFFI7433WATG",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "uri",
        "term_id",
        "description",
        "synonyms",
        "subontology",
        "class",
        "method",
        "files_filesets"
      ]
    }
  ],
  "additionalProperties": false,
  "accessible_via": {
    "return": "_id, uri, term_id, name, synonyms, description, source, subontology, source_url, class, method, files_filesets"
  },
  "db_collection_name": "ontology_terms"
}
