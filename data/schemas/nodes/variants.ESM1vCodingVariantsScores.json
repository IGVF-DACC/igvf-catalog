{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/variants.ESM1vCodingVariantsScores.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "variants.base.json"
    },
    {
      "type": "object",
      "properties": {
        "variation_type": {
          "enum": [
            "SNP",
            "deletion-insertion"
          ]
        },
        "source": {
          "description": "The database, dataset or organization that is a source for these data.",
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "description": "The URL for the source.",
          "example": "https://data.igvf.org/tabular-files/IGVFFI8105TNNO",
          "pattern": "^https://data.igvf.org/tabular-files/"
        }
      },
      "additionalProperties": false
    }
  ],
  "db_collection_name": "variants"
}
