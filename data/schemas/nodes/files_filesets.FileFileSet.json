{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/files_filesets.FileFileSet.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "ENCFF004PFU"
        },
        "name": {
          "example": "ENCFF004PFU"
        },
        "file_set_id": {
          "type": "string",
          "description": "Accession of the file set that contains this file: the unique identifier used to reference that file set on the source portal.",
          "example": "ENCSR359DFW"
        },
        "lab": {
          "type": "string",
          "description": "Lab associated with the submission.",
          "enum": [
            "alan-boyle",
            "bill-majoros",
            "charles-gersbach",
            "community",
            "danwei-huangfu",
            "doug-fowler",
            "encode",
            "gary-hon",
            "j-michael-cherry",
            "jay-shendure",
            "jesse-engreitz",
            "karen-mohlke",
            "kushal-dey",
            "lea-starita",
            "luca-pinello",
            "marc-vidal",
            "mark-craven",
            "nadav-ahituv",
            "predrag-radivojac",
            "richard-sherwood",
            "thomas-quertermous",
            "tim-reddy",
            "tom-norman",
            "zhiping-weng"
          ],
          "example": "jesse-engreitz"
        },
        "preferred_assay_titles": {
          "type": [
            "array",
            "null"
          ],
          "description": "Preferred assay title from the IGVF Portal.",
          "items": {
            "type": "string",
            "enum": [
              "CRISPR FACS screen",
              "CRISPR FlowFISH screen",
              "DNase-seq",
              "DUAL-IPA",
              "electroporated MPRA",
              "lentiMPRA",
              "Migration CRISPR screen",
              "MPRA",
              "Multiome Perturb-seq",
              "Perturb-seq",
              "Parse Perturb-seq",
              "Proliferation CRISPR screen",
              "scCRISPR screen",
              "SGE",
              "snATAC-seq",
              "STARR-seq",
              "TAP-seq",
              "VAMP-seq",
              "VAMP-seq (MultiSTEP)",
              "Variant painting via fluorescence",
              "Variant-EFFECTS"
            ]
          },
          "example": [
            "lentiMPRA"
          ]
        },
        "assay_term_ids": {
          "type": [
            "array",
            "null"
          ],
          "description": "Ontology term identifiers for the assays used to produce the data.",
          "example": [
            "OBI:0002440"
          ],
          "items": {
            "type": "string"
          }
        },
        "method": {
          "$ref": "../mixins.json#/method",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ADASTRA",
            "BlueSTARR",
            "ClinGen",
            "COXPRESdb",
            "CRISPR screen",
            "DepMap",
            "DUAL-IPA",
            "ENCODE-rE2G",
            "ESM-1v",
            "GenCC",
            "GVATdb",
            "GWAS",
            "HOCOMOCO",
            "Homology",
            "MPRA",
            "MutPred2",
            "Orphanet",
            "Perturb-seq",
            "PharmGKB",
            "SEMVAR",
            "SEMpl",
            "SGE",
            "STARR-seq",
            "TopLD",
            "training data for predictive models",
            "VAMP-seq",
            "VAMP-seq (MultiSTEP)",
            "Variant painting via fluorescence",
            "Variant-EFFECTS",
            "cV2F",
            "caQTL",
            "candidate Cis-Regulatory Elements",
            "eQTL",
            "elements",
            "pQTL",
            "scATAC-seq",
            "scE2G",
            "snATAC-seq",
            "spliceQTL",
            null
          ]
        },
        "class": {
          "$ref": "../mixins.json#/class",
          "enum": [
            "biological relationship",
            "observed data",
            "prediction"
          ]
        },
        "software": {
          "type": [
            "array",
            "null"
          ],
          "description": "Name of the software packages used to produce the file.",
          "items": {
            "type": "string",
            "enum": [
              "2024_multistep",
              "BCalm",
              "BEDTools",
              "bigWigAverageOverBed",
              "BIRD",
              "BlueSTARR",
              "CRISPR BEAN",
              "CRISPR-Millipede",
              "CRISPR-SURF",
              "CRISPResso2",
              "Cell Profiler",
              "Cooler",
              "CountESS",
              "cV2F",
              "cyp2c19_2c9",
              "DESeq2",
              "Distal regulation ENCODE-rE2G",
              "DUAL-IPA analysis scripts",
              "DistalRegulationCRISPRdata",
              "Variant-EFFECTS",
              "ESM-1v",
              "FRACTEL",
              "Irreproducible Discovery Rate",
              "matplotlib",
              "MPRAflow tsv-to-bed",
              "mpralm",
              "MutPred2",
              "NumPy",
              "pandas",
              "pybedtools",
              "Pysam",
              "pySpade",
              "R",
              "Samtools",
              "scATAC-seq processing",
              "Seaborn",
              "SEMVAR",
              "SEMpl",
              "scE2G",
              "Sceptre",
              "SciPy",
              "Seurat",
              "SGE Pipeline",
              "Snakemake",
              "statsmodels",
              "Straw"
            ]
          }
        },
        "samples": {
          "type": [
            "array",
            "null"
          ],
          "description": "Ontology terms identifying the biosamples the data was produced from.",
          "example": [
            "ontology_terms/UBERON_0002048"
          ],
          "items": {
            "type": "string",
            "pattern": "^ontology_terms/[A-Z0-9_]+$"
          }
        },
        "sample_ids": {
          "type": [
            "array",
            "null"
          ],
          "description": "ENCODE or IGVF Accessions of the samples the data was produced from.",
          "example": [
            "ENCBS160ZPI",
            "ENCBS659PKW",
            "ENCBS825OJD"
          ],
          "items": {
            "type": "string"
          }
        },
        "simple_sample_summaries": {
          "type": [
            "array",
            "null"
          ],
          "description": "Short readable summary of each sample.",
          "example": [
            "GM12878"
          ]
        },
        "donors": {
          "type": [
            "array",
            "null"
          ],
          "description": "ENCODE or IGVF Donors the samples were derived from.",
          "example": [
            "donors/ENCDO000AAK"
          ],
          "items": {
            "type": "string",
            "pattern": "^donors/[A-Z0-9]+$"
          }
        },
        "treatments_term_ids": {
          "$ref": "../mixins.json#/treatments_term_ids",
          "example": [
            "CHEBI:15367"
          ]
        },
        "publication": {
          "type": [
            "string",
            "null"
          ],
          "description": "Publication identifier associated with the file set.",
          "example": "PMID:34017130"
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "string",
            "minItems": 1
          },
          "description": "The collections in the IGVF catalog that contain the data in this file.",
          "example": [
            "genomic_elements"
          ]
        },
        "source": {
          "enum": [
            "ENCODE",
            "IGVF",
            "Community"
          ]
        },
        "source_url": {
          "example": "https://api.data.igvf.org/tabular-files/IGVFFI6913PEWI/",
          "type": [
            "string",
            "null"
          ]
        },
        "download_link": {
          "type": "string",
          "description": "The download path to obtain the file from the source portal.",
          "example": "https://api.data.igvf.org/signal-files/IGVFFI8400FXRX/@@download/IGVFFI8400FXRX.bigWig"
        },
        "cell_annotation": {
          "type": [
            "string",
            "null"
          ],
          "description": "The cell annotation of the file set, with optional qualifier, for single-cell derived results.",
          "example": "pluripotent epiblast cell derived from mouse embryonic stem cell"
        },
        "cell_annotation_term": {
          "type": [
            "string",
            "null"
          ],
          "description": "Base ontology term describing the cell type of a single-cell derived result.",
          "example": "ontology_terms/CL_0000352",
          "pattern": "^ontology_terms/[A-Z0-9_]+$"
        },
        "genome_browser_link": {
          "type": [
            "string",
            "null"
          ],
          "description": "Link to a file that can be rendered in a genome browser: the file set's bigInteract, bigBed, bigWig, or bedpe file where one exists, or the file itself for a pseudobulk set.",
          "example": "https://api.data.igvf.org/signal-files/IGVFFI8400FXRX/@@download/IGVFFI8400FXRX.bigWig"
        },
        "browser_index_file": {
          "type": [
            "string",
            "null"
          ],
          "description": "Download link for the genome browser index file (.tbi).",
          "example": "https://api.data.igvf.org/index-files/IGVFFI3262ZXDO/@@download/IGVFFI3262ZXDO.tbi"
        },
        "crispr_modality": {
          "$ref": "../mixins.json#/crispr_modality",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "interference",
            "activation",
            "base editing",
            "prime editing",
            "knockout"
          ],
          "example": "interference"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Version of the external data source",
          "example": "File generated on 2023-10-10"
        }
      },
      "required": [
        "file_set_id",
        "lab",
        "preferred_assay_titles",
        "assay_term_ids",
        "method",
        "class",
        "software",
        "samples",
        "sample_ids",
        "simple_sample_summaries",
        "donors",
        "treatments_term_ids",
        "publication",
        "download_link",
        "cell_annotation",
        "cell_annotation_term",
        "browser_index_file",
        "crispr_modality"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "return": "_id, file_set_id, lab, preferred_assay_titles, assay_term_ids, method, class, collections, software, samples, sample_ids, simple_sample_summaries, donors, treatments_term_ids, publication, source, source_url, download_link, cell_annotation, cell_annotation_term, genome_browser_link, browser_index_file, crispr_modality"
  },
  "db_collection_name": "files_filesets"
}
