{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/genomic_elements.scE2G.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "promoter_chr1_169893055_169894554_GRCh38_IGVFFI5648GWQX"
        },
        "name": {
          "example": "promoter_chr1_169893055_169894554_GRCh38_IGVFFI5648GWQX"
        },
        "method": {
          "enum": [
            "scE2G"
          ]
        },
        "type": {
          "enum": [
            "accessible dna elements"
          ]
        },
        "source_annotation": {
          "title": "Source Annotation",
          "type": "string",
          "description": "Annotation of the element supplied by the source.",
          "enum": [
            "genic",
            "intergenic",
            "promoter",
            "enhancer"
          ],
          "enum_descriptions": {
            "genic": "An element within a gene body.",
            "intergenic": "An element between annotated genes.",
            "promoter": "An element associated with transcription initiation at a gene.",
            "enhancer": "An element annotated as potentially regulating transcription from a promoter."
          }
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI5648GWQX",
          "pattern": "^https://data\\.igvf\\.org/tabular-files/"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      },
      "required": [
        "source_annotation",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements",
  "threshold": "No separate statistical significance call is assigned to these entity records. Source association filters and significance criteria are documented in genomic_elements_genes.scE2G.json; presence of an entity does not imply a significant association."
}
