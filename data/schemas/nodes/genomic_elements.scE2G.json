{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/genomic_elements.scE2G.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "promoter_chr1_169893055_169894554_GRCh38_IGVFFI5648GWQX"
        },
        "name": {
          "example": "promoter_chr1_169893055_169894554_GRCh38_IGVFFI5648GWQX"
        },
        "method": {
          "enum": [
            "scE2G"
          ]
        },
        "type": {
          "enum": [
            "accessible dna elements"
          ]
        },
        "source_annotation": {
          "type": "string",
          "description": "Source annotation for the genomic element",
          "enum": [
            "genic",
            "intergenic",
            "promoter"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI5648GWQX",
          "pattern": "^https://data\\.igvf\\.org/tabular-files/"
        },
        "files_filesets": {
          "type": "string",
          "description": "Filesets for the genomic element",
          "example": "files_filesets/IGVFFI5648GWQX",
          "pattern": "^files_filesets/"
        }
      },
      "required": [
        "source_annotation",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements"
}
