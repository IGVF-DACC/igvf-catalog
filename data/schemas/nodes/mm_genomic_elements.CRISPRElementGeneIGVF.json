{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/mm_genomic_elements.CRISPRElementGeneIGVF.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "CRISPR_chr9_116004181_116004247_GRCm39_IGVFFI9159XDOS"
        },
        "name": {
          "example": "CRISPR_chr9_116004181_116004247_GRCm39_IGVFFI9159XDOS"
        },
        "promoter_of": {
          "type": "string",
          "description": "The gene this element is the presumed promoter of.",
          "example": "mm_genes/ENSMUSG00000032440"
        },
        "method": {
          "enum": [
            "Perturb-seq",
            "CRISPR screen"
          ]
        },
        "source_annotation": {
          "type": "string",
          "description": "Annotation of the element, usually enhancer, promoter, distal or accessible element.",
          "example": "promoter",
          "enum": [
            "enhancer",
            "promoter",
            "distal element"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://api.data.igvf.org/tabular-files/IGVFFI9159XDOS/"
        },
        "type": {
          "enum": [
            "tested elements"
          ]
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      },
      "required": [
        "source_annotation",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "mm_genomic_elements"
}
