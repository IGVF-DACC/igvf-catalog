{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nodes/mm_genomic_elements.HumanMouseElementAdapter.json",
  "db_collection_name": "mm_genomic_elements",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "properties": {
        "method": {
          "$ref": "../mixins.json#/method"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "chr": {
          "type": "string",
          "description": "Mouse chromosome the element lies on, prefixed with 'chr'. Scaffolds and patch regions use UCSC-style names.",
          "example": "chr6"
        },
        "start": {
          "type": "number",
          "description": "Start of the element, 0-based and inclusive.",
          "example": 121522229
        },
        "end": {
          "type": "number",
          "description": "End of the mouse element on mm10, 0-based and exclusive.",
          "example": 121522428
        },
        "method": {
          "enum": [
            "integrative"
          ]
        },
        "type": {
          "type": "string",
          "description": "Category of element: a mouse DNase hypersensitive site paired to a human site by FUNCODE.",
          "enum": [
            "accessible dna elements (mouse)"
          ]
        },
        "source": {
          "enum": [
            "FUNCODE"
          ]
        },
        "source_url": {
          "pattern": "^https://data.igvf.org/reference-files/"
        }
      },
      "required": [
        "chr",
        "start",
        "end",
        "method",
        "type"
      ]
    }
  ],
  "additionalProperties": false,
  "accessible_via": {
    "filter_by_range": "start, end",
    "return": "_id, chr, start, end, method, type, source, source_url, name"
  }
}
