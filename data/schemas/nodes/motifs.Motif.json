{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/motifs.Motif.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "motifs.base.json"
    },
    {
      "properties": {
        "method": {
          "$ref": "../mixins.json#/method"
        },
        "class": {
          "$ref": "../mixins.json#/class"
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "HOCOMOCOv11"
          ]
        },
        "source_url": {
          "pattern": "^hocomoco11\\.autosome\\.org/motif/.*$",
          "example": "hocomoco11.autosome.org/motif/ATF1_HUMAN.H11MO.0.B"
        },
        "class": {
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "enum": [
            "HOCOMOCO"
          ]
        }
      },
      "required": [
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false,
      "accessible_via": {
        "return": "_id, name, tf_name, source, source_url, pwm, length, class, method, files_filesets"
      }
    }
  ],
  "db_collection_name": "motifs"
}
