{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/motifs.Motif.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "motifs.base.json"
    },
    {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "HOCOMOCOv11"
          ]
        },
        "source_url": {
          "pattern": "^https://hocomoco11\\.autosome\\.org/downloads_v11$",
          "example": "https://hocomoco11.autosome.org/downloads_v11"
        },
        "class": {
          "$ref": "../mixins.json#/class",
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "$ref": "../mixins.json#/method",
          "enum": [
            "HOCOMOCO"
          ]
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      },
      "required": [
        "class",
        "method",
        "files_filesets"
      ],
      "additionalProperties": false,
      "accessible_via": {
        "return": "_id, name, tf_name, source, source_url, pwm, length, class, method, files_filesets"
      }
    }
  ],
  "db_collection_name": "motifs"
}
