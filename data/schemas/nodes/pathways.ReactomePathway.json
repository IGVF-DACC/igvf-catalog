{
  "$id": "schemas/nodes/pathways.ReactomePathway.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "properties": {
        "organism": {
          "$ref": "../mixins.json#/organism/organism"
        }
      }
    },
    {
      "properties": {
        "source": {
          "$ref": "../mixins.json#/provenance/source"
        },
        "source_url": {
          "$ref": "../mixins.json#/provenance/source_url"
        },
        "method": {
          "$ref": "../mixins.json#/classification/method"
        },
        "label": {
          "$ref": "../mixins.json#/classification/label"
        },
        "class": {
          "$ref": "../mixins.json#/classification/class"
        }
      }
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/file_metadata/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "pattern": "^R-HSA-[0-9]+$",
          "example": "R-HSA-1971475"
        },
        "name": {
          "description": "Human readable display name for the entity",
          "example": "A tetrasaccharide linker sequence is required for GAG synthesis"
        },
        "organism": {
          "enum": [
            "Homo sapiens"
          ]
        },
        "class": {
          "type": "string",
          "enum": [
            "biological relationship"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_filesets": {
          "example": "files_filesets/IGVFFI6981KOFP",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        },
        "source": {
          "enum": [
            "Reactome"
          ]
        },
        "source_url": {
          "enum": [
            "https://reactome.org/"
          ]
        },
        "id_version": {
          "type": "string",
          "description": "Reactome stable identifier with its version suffix.",
          "example": "R-HSA-1971475.4"
        },
        "is_in_disease": {
          "type": "boolean",
          "description": "Whether Reactome annotates this pathway as a disease pathway.",
          "example": true
        },
        "name_aliases": {
          "type": "array",
          "description": "Names Reactome lists for the pathway, including the display name.",
          "example": [
            "A tetrasaccharide linker sequence is required for GAG synthesis"
          ]
        },
        "is_top_level_pathway": {
          "type": "boolean",
          "description": "Whether this is a Reactome top-level pathway.",
          "example": true
        },
        "disease_ontology_terms": {
          "type": "array",
          "description": "Disease ontology terms Reactome associates with this pathway.",
          "example": [
            "ontology_terms/DOID_12345"
          ],
          "items": {
            "type": "string",
            "pattern": "^ontology_terms/[A-Z0-9_]+$"
          }
        },
        "go_biological_process": {
          "type": "string",
          "description": "Gene Ontology biological process term for this pathway, as a handle into ontology_terms.",
          "example": "ontology_terms/GO_0006914",
          "pattern": "^ontology_terms/[A-Z0-9_]+$"
        }
      },
      "required": [
        "organism",
        "id_version",
        "is_in_disease",
        "name_aliases",
        "is_top_level_pathway",
        "class",
        "method",
        "label",
        "files_filesets"
      ]
    }
  ],
  "additionalProperties": false,
  "accessible_via": {
    "return": "_id, name, name_aliases, is_top_level_pathway, is_in_disease, disease_ontology_terms, go_biological_process, id_version, organism, class, method, label, files_filesets, source, source_url"
  },
  "db_collection_name": "pathways"
}
