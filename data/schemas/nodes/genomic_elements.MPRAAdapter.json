{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/genomic_elements.MPRAAdapter.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "MPRA_chr1_10410_10610_GRCh38_ENCFF769REH"
        },
        "name": {
          "description": "Human readable display name for the entity",
          "example": "MPRA_chr1_10410_10610_GRCh38_ENCFF769REH"
        },
        "strand": {
          "type": "string",
          "description": "Strand the tile was tested in: '+' or '-', or '.' where the reference sequence design does not record one.",
          "enum": [
            "+",
            "-",
            "."
          ]
        },
        "method": {
          "description": "Name of the experimental class or prediction model that produced this result.",
          "enum": [
            "MPRA"
          ]
        },
        "type": {
          "enum": [
            "tested elements"
          ]
        },
        "source": {
          "description": "The database, dataset or organization that is a source for these data.",
          "enum": [
            "IGVF",
            "ENCODE"
          ]
        },
        "source_url": {
          "description": "The URL for the source.",
          "example": "https://www.encodeproject.org/files/ENCFF769REH/"
        },
        "files_filesets": {
          "type": "string",
          "description": "Reference to the File and Metadata",
          "pattern": "^files_filesets/"
        }
      },
      "required": [
        "files_filesets",
        "strand"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements"
}
