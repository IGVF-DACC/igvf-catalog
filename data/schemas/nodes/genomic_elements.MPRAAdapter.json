{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/genomic_elements.MPRAAdapter.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "MPRA_chr1_10410_10610_GRCh38_ENCFF769REH"
        },
        "name": {
          "example": "MPRA_chr1_10410_10610_GRCh38_ENCFF769REH"
        },
        "strand": {
          "description": "Strand the tile was tested in..",
          "enum": [
            "+",
            "-",
            "."
          ],
          "enum_descriptions": {
            "+": "Forward strand of the reference sequence.",
            "-": "Reverse strand of the reference sequence.",
            ".": "Strand is not recorded or is not applicable."
          }
        },
        "method": {
          "enum": [
            "MPRA"
          ]
        },
        "type": {
          "enum": [
            "tested elements"
          ]
        },
        "source": {
          "enum": [
            "IGVF",
            "ENCODE"
          ]
        },
        "source_url": {
          "example": "https://www.encodeproject.org/files/ENCFF769REH/"
        }
      },
      "required": [
        "files_filesets",
        "strand"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements"
}
