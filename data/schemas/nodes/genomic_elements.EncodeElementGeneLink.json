{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/genomic_elements.EncodeElementGeneLink.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "genic_chr1_869658_870158_GRCh38_ENCFF003BKC"
        },
        "name": {
          "example": "genic_chr1_869658_870158_GRCh38_ENCFF003BKC"
        },
        "method": {
          "enum": [
            "ENCODE-rE2G"
          ]
        },
        "type": {
          "enum": [
            "accessible dna elements"
          ]
        },
        "source_annotation": {
          "type": "string",
          "description": "Class of the element as reported by ENCODE-rE2G: a promoter, genic where it falls inside a gene body, or intergenic.",
          "enum": [
            "genic",
            "intergenic",
            "promoter"
          ]
        },
        "source": {
          "enum": [
            "ENCODE"
          ]
        },
        "source_url": {
          "example": "https://www.encodeproject.org/files/ENCFF003BKC/",
          "pattern": "^https://www.encodeproject.org/files/"
        },
        "files_filesets": {
          "type": "string",
          "description": "Handle of the files_filesets record for the ENCODE thresholded element-gene file this element was read from.",
          "example": "files_filesets/ENCFF003BKC",
          "pattern": "^files_filesets/"
        },
        "simple_sample_summaries": {
          "type": [
            "array",
            "null"
          ],
          "description": "Short readable summaries of the samples the prediction was made in, copied from the file's fileset metadata.",
          "example": [
            "head of caudate nucleus from ENCDO948PMW"
          ]
        },
        "treatments_term_ids": {
          "type": [
            "array",
            "null"
          ],
          "description": "Ontology term identifiers for the treatments applied to the samples, taken from the file's fileset metadata. Null when none were applied.",
          "example": [
            "UniProtKB:P05112"
          ]
        }
      },
      "required": [
        "source_annotation",
        "files_filesets",
        "simple_sample_summaries",
        "treatments_term_ids"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements"
}
