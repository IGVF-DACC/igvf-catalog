{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/genomic_elements.EncodeElementGeneLink.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        },
        "treatments_term_ids": {
          "$ref": "../mixins.json#/treatments_term_ids"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "genic_chr1_869658_870158_GRCh38_ENCFF003BKC"
        },
        "name": {
          "example": "genic_chr1_869658_870158_GRCh38_ENCFF003BKC"
        },
        "method": {
          "enum": [
            "ENCODE-rE2G"
          ]
        },
        "type": {
          "enum": [
            "accessible dna elements"
          ]
        },
        "source_annotation": {
          "title": "Source Annotation",
          "type": "string",
          "description": "Annotation of the element supplied by the source.",
          "enum": [
            "genic",
            "intergenic",
            "promoter"
          ],
          "enum_descriptions": {
            "genic": "An element within a gene body.",
            "intergenic": "An element between annotated genes.",
            "promoter": "An element associated with transcription initiation at a gene."
          }
        },
        "source": {
          "enum": [
            "ENCODE"
          ]
        },
        "source_url": {
          "example": "https://www.encodeproject.org/files/ENCFF003BKC/",
          "pattern": "^https://www.encodeproject.org/files/"
        },
        "simple_sample_summaries": {
          "title": "Simple Sample Summaries",
          "type": [
            "array",
            "null"
          ],
          "description": "Short readable summary of each sample.",
          "example": [
            "head of caudate nucleus from ENCDO948PMW"
          ]
        },
        "treatments_term_ids": {
          "example": [
            "UniProtKB:P05112"
          ]
        }
      },
      "required": [
        "source_annotation",
        "files_filesets",
        "simple_sample_summaries",
        "treatments_term_ids"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements"
}
