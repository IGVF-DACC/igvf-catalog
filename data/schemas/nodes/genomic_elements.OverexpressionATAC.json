{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/genomic_elements.OverexpressionATAC.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "ATAC_chr1_10002_10616_GRCh38_IGVFFI2320OTYL",
          "title": "Key"
        },
        "name": {
          "example": "ATAC_chr1_10002_10616_GRCh38_IGVFFI2320OTYL",
          "title": "Name"
        },
        "method": {
          "enum": [
            "ATAC-seq"
          ]
        },
        "source": {
          "enum": [
            "IGVF"
          ],
          "title": "Source",
          "enum_descriptions": {
            "IGVF": "Impact of Genomic Variation on Function Consortium."
          }
        },
        "source_url": {
          "example": "https://data.igvf.org/tabular-files/IGVFFI2320OTYL/",
          "title": "Source URL"
        },
        "type": {
          "enum": [
            "accessible dna elements"
          ]
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets",
          "title": "Files and Filesets"
        }
      },
      "required": [
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements",
  "accessible_via": {
    "filter_by_range": "start, end"
  }
}
