{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/variants.CRISPRVariantPhenotype.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "variants.base.json"
    },
    {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://api.data.igvf.org/tabular-files/IGVFFI2014OOZP/",
          "pattern": "^https://api.data.igvf.org/tabular-files/"
        },
        "files_filesets": {
          "type": "string",
          "description": "Filesets of the variant",
          "example": "files_filesets/IGVFFI2014OOZP",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "variants"
}
