{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/studies.EQTLCatalog.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "properties": {
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "QTS000038"
        },
        "name": {
          "example": "OneK1K"
        },
        "pmid": {
          "title": "PubMed ID",
          "type": "string",
          "description": "PubMed identifier.",
          "example": "35389779"
        },
        "study_type": {
          "title": "Study Type",
          "type": "string",
          "description": "Resolution at which gene expression was measured.",
          "enum": [
            "single-cell",
            "bulk"
          ],
          "enum_descriptions": {
            "single-cell": "Expression is measured in individual cells.",
            "bulk": "Expression is measured across a population of cells."
          }
        },
        "source": {
          "enum": [
            "EBI"
          ]
        }
      },
      "required": [
        "pmid",
        "study_type",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "return": "_id, name, pmid, study_type, source, source_url, files_filesets"
  },
  "db_collection_name": "studies"
}
