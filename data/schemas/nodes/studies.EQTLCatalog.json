{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "schemas/nodes/studies.EQTLCatalog.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "QTS000038"
        },
        "name": {
          "description": "Human readable display name for the entity",
          "example": "OneK1K"
        },
        "pmid": {
          "type": "string",
          "description": "PubMed identifier.",
          "example": "35389779"
        },
        "study_type": {
          "type": "string",
          "description": "Whether the study measured expression in bulk tissue or in single cells.",
          "enum": [
            "single-cell",
            "bulk"
          ]
        },
        "source": {
          "description": "The database, dataset or organization that is a source for these data.",
          "enum": [
            "EBI"
          ]
        },
        "source_url": {
          "description": "The URL for the source."
        },
        "files_filesets": {
          "type": "string",
          "description": "Reference to the File and Metadata"
        }
      },
      "required": [
        "pmid",
        "study_type",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "accessible_via": {
    "return": "_id, name, pmid, study_type, source, source_url, files_filesets"
  },
  "db_collection_name": "studies"
}
