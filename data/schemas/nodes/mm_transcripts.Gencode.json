{
  "$id": "schemas/nodes/mm_transcripts.Gencode.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "pattern": "^ENSMUST[0-9]{11}(?:_PAR_Y)?$",
          "example": "ENSMUST00000161581"
        },
        "transcript_id": {
          "type": "string",
          "description": "ENSEMBL transcript ID, without version number.",
          "example": "ENSMUST00000161581.2",
          "pattern": "^ENSMUST[0-9]{11}\\.[0-9]+(?:_PAR_Y)?$"
        },
        "name": {
          "description": "Human readable display name for the entity",
          "example": "Gm1992-201"
        },
        "transcript_type": {
          "type": "string",
          "description": "Biotype GENCODE assigns to the transcript.",
          "example": "lncRNA"
        },
        "chr": {
          "type": "string",
          "description": "Chromosome the transcript lies on, prefixed with 'chr'. Scaffolds and patch regions use UCSC-style names.",
          "example": "chr1",
          "pattern": "^chr"
        },
        "start": {
          "type": "number",
          "description": "Start of the transcript, 0-based and inclusive.",
          "example": 3536809
        },
        "end": {
          "type": "number",
          "description": "End of the transcript, 0-based and exclusive.",
          "example": 3583776
        },
        "strand": {
          "type": "string",
          "description": "Strand the transcript is transcribed from: '+' for the forward strand, '-' for the reverse strand.",
          "enum": [
            "+",
            "-"
          ],
          "example": "+"
        },
        "gene_name": {
          "type": "string",
          "description": "HGNC gene symbol",
          "example": "Gm1992"
        },
        "source": {
          "description": "The database, dataset or organization that is a source for these data.",
          "enum": [
            "GENCODE"
          ]
        },
        "version": {
          "type": "string",
          "description": "GENCODE release the annotation was taken from.",
          "enum": [
            "vM36"
          ]
        },
        "source_url": {
          "description": "The URL for the source.",
          "enum": [
            "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M36/gencode.vM36.chr_patch_hapl_scaff.annotation.gtf.gz"
          ]
        },
        "organism": {
          "type": "string",
          "description": "Species this annotation describes.",
          "enum": [
            "Mus musculus"
          ]
        }
      },
      "required": [
        "transcript_id",
        "transcript_type",
        "chr",
        "start",
        "end",
        "strand",
        "gene_name",
        "version",
        "organism"
      ]
    }
  ],
  "additionalProperties": false,
  "accessible_via": {
    "filter_by_range": "start, end",
    "return": "_id, chr, start, end, strand, gene_name, transcript_id, name, transcript_type, source, version, source_url, organism"
  },
  "db_collection_name": "mm_transcripts"
}
