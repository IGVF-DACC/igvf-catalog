{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/genomic_elements.CRISPRElementGeneENCODE.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "CRISPR_chr1_3774714_3775214_GRCh38_ENCFF968BZL"
        },
        "name": {
          "example": "CRISPR_chr1_3774714_3775214_GRCh38_ENCFF968BZL"
        },
        "source_annotation": {
          "type": "string",
          "description": "enhancer if the element is significant for any tested gene in the file; negative control otherwise.",
          "enum": [
            "enhancer",
            "negative control"
          ]
        },
        "files_filesets": {
          "type": "string",
          "description": "Handle of the files_filesets record for the ENCODE combined CRISPR quantification file this element was read from.",
          "example": "files_filesets/ENCFF968BZL"
        },
        "method": {
          "enum": [
            "CRISPR screen"
          ]
        }
      },
      "required": [
        "source_annotation",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements"
}
