{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/nodes/genomic_elements.CRISPRElementGeneENCODE.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "genomic_elements.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "example": "CRISPR_chr1_3774714_3775214_GRCh38_ENCFF968BZL"
        },
        "name": {
          "description": "Human readable display name for the entity",
          "example": "CRISPR_chr1_3774714_3775214_GRCh38_ENCFF968BZL"
        },
        "source_annotation": {
          "type": "string",
          "description": "Annotation of the element, usually enhancer, promoter, distal or accessible element.",
          "enum": [
            "enhancer",
            "negative control"
          ]
        },
        "files_filesets": {
          "type": "string",
          "description": "Reference to the File and Metadata",
          "example": "files_filesets/ENCFF968BZL"
        },
        "method": {
          "description": "Name of the experimental class or prediction model that produced this result.",
          "enum": [
            "CRISPR screen"
          ]
        }
      },
      "required": [
        "source_annotation",
        "files_filesets"
      ],
      "additionalProperties": false
    }
  ],
  "db_collection_name": "genomic_elements"
}
