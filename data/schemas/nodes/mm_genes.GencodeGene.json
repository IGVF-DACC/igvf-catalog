{
  "$id": "schemas/nodes/mm_genes.GencodeGene.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "type": "object",
      "properties": {
        "_key": {
          "pattern": "^ENSMUSG[0-9]{11}(?:_PAR_Y)?$",
          "example": "ENSMUSG00000094271"
        },
        "gene_id": {
          "type": "string",
          "description": "Ensembl gene ID including its version suffix.",
          "pattern": "^ENSMUSG[0-9]{11}\\.[0-9]+(?:_PAR_Y)?$"
        },
        "gene_type": {
          "type": "string",
          "description": "Biotype GENCODE assigns to the gene.",
          "example": "protein_coding"
        },
        "chr": {
          "type": "string",
          "description": "Chromosome the gene lies on, prefixed with 'chr'. Scaffolds and patch regions use UCSC-style names.",
          "example": "chr9",
          "pattern": "^chr"
        },
        "start": {
          "type": "number",
          "description": "Start of the gene, 0-based and inclusive.",
          "example": 11869
        },
        "end": {
          "type": "number",
          "description": "End of the gene, 0-based and exclusive.",
          "example": 14409
        },
        "strand": {
          "type": "string",
          "description": "Strand the gene is transcribed from: '+' for the forward strand, '-' for the reverse strand.",
          "enum": [
            "+",
            "-"
          ]
        },
        "name": {
          "description": "Human readable display name for the entity",
          "example": "Gm13290"
        },
        "symbol": {
          "type": "string",
          "description": "GENCODE gene symbol.",
          "example": "Gm13290"
        },
        "source": {
          "description": "The database, dataset or organization that is a source for these data.",
          "enum": [
            "GENCODE"
          ]
        },
        "version": {
          "type": "string",
          "description": "GENCODE release the annotation was taken from.",
          "enum": [
            "vM36"
          ]
        },
        "source_url": {
          "description": "The URL for the source.",
          "enum": [
            "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M36/gencode.vM36.chr_patch_hapl_scaff.annotation.gtf.gz"
          ]
        },
        "organism": {
          "type": "string",
          "description": "Species this annotation describes.",
          "enum": [
            "Mus musculus"
          ]
        },
        "study_sets": {
          "type": [
            "array",
            "null"
          ],
          "description": "IGVF study sets that include this gene. ",
          "items": {
            "type": "string"
          }
        },
        "collections": {
          "type": [
            "array",
            "null"
          ],
          "description": "The collections in the IGVF catalog that contain the data in this file.",
          "items": {
            "type": "string"
          }
        },
        "version_number": {
          "type": "string",
          "description": "Version suffix of the Ensembl gene ID.",
          "example": "1"
        },
        "mgi": {
          "type": "string",
          "description": "MGI ID for the gene.",
          "example": "MGI:3701990",
          "pattern": "^MGI:[0-9]+$"
        },
        "synonyms": {
          "type": "array",
          "description": "Alternative symbols and names for the gene, gathered from the NCBI gene info file: its synonyms, other designations, and nomenclature-authority symbol and full name.",
          "items": {
            "type": "string"
          }
        },
        "entrez": {
          "type": "string",
          "description": "Entrez gene ID for the gene, prefixed with 'ENTREZ:'.",
          "example": "ENTREZ:100287102",
          "pattern": "^ENTREZ:[0-9]+$"
        }
      },
      "required": [
        "gene_id",
        "gene_type",
        "chr",
        "start",
        "end",
        "strand",
        "symbol",
        "version",
        "organism",
        "study_sets",
        "collections",
        "version_number"
      ]
    }
  ],
  "additionalProperties": false,
  "accessible_via": {
    "filter_by_range": "start, end",
    "simplified_return": "_id, chr, gene_id, mgi, name, organism",
    "return": "_id, chr, start, end, gene_id, mgi, entrez, name, gene_type, source, version, source_url, organism"
  },
  "db_collection_name": "mm_genes"
}
