{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/motifs.SEMMotif.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "motifs.base.json"
    },
    {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/model-files/IGVFFI9967LYCS",
          "pattern": "^https://data.igvf.org/model-files/"
        },
        "SEMpl_baseline": {
          "type": "number",
          "description": "log2 of the average transcription factor binding signal across randomly scrambled endogenous kmers.",
          "example": -0.671761
        },
        "class": {
          "$ref": "../mixins.json#/class",
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "$ref": "../mixins.json#/method",
          "enum": [
            "SEMpl"
          ]
        },
        "files_filesets": {
          "$ref": "../mixins.json#/files_filesets"
        }
      },
      "required": [
        "SEMpl_baseline",
        "class",
        "method",
        "files_filesets"
      ],
      "accessible_via": {
        "return": "_id, name, tf_name, source, source_url, pwm, length, SEMpl_baseline, class, method, files_filesets"
      }
    }
  ],
  "additionalProperties": false,
  "db_collection_name": "motifs"
}
