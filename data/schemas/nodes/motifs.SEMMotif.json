{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/nodes/motifs.SEMMotif.json",
  "allOf": [
    {
      "$ref": "node.base.json"
    },
    {
      "$ref": "motifs.base.json"
    },
    {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "IGVF"
          ]
        },
        "source_url": {
          "example": "https://data.igvf.org/model-files/IGVFFI9967LYCS",
          "pattern": "^https://data.igvf.org/model-files/"
        },
        "baseline": {
          "type": "number",
          "description": "The baseline of the motif",
          "example": -0.671761
        },
        "class": {
          "type": "string",
          "description": "The class of the motif, from the associated files_filesets record",
          "enum": [
            "observed data"
          ]
        },
        "method": {
          "type": "string",
          "description": "The method of the motif, from the associated files_filesets record",
          "enum": [
            "SEMpl"
          ]
        },
        "files_filesets": {
          "type": "string",
          "description": "The files filesets of the motif",
          "example": "files_filesets/IGVFFI5279OTVZ",
          "pattern": "^files_filesets/",
          "collections": [
            "files_filesets"
          ]
        }
      },
      "required": [
        "baseline",
        "class",
        "method",
        "files_filesets"
      ],
      "accessible_via": {
        "return": "_id, name, tf_name, source, source_url, pwm, length, baseline, class, method, files_filesets"
      }
    }
  ],
  "additionalProperties": false,
  "db_collection_name": "motifs"
}
